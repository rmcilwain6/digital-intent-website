---
// Orthography fixture (SPEC section 6). Renders Indigenous place names and
// orthographies in every font weight in use, so a person can check the brand
// fonts before launch.
import BaseLayout from '../../layouts/BaseLayout.astro';

const samples = [
  'Secwépemc',
  'Lək̓ʷəŋən',
  'xʷməθkʷəy̓əm',
  'Sḵwx̱wú7mesh',
  'səl̓ilw̓ətaʔɬ',
];

// Keep in step with the --font-weight-* tokens in src/brand/tokens.css.
const weights = [
  { label: 'Regular', token: '--font-weight-regular' },
  { label: 'Bold', token: '--font-weight-bold' },
];

// Keep in step with the faces in src/brand/fonts.css.
const families = [
  { label: 'Body', token: '--font-body', style: 'normal' },
  { label: 'Body italic', token: '--font-body', style: 'italic' },
  { label: 'Heading', token: '--font-heading', style: 'normal' },
  { label: 'Mono', token: '--font-mono', style: 'normal' },
];
---

<BaseLayout
  title="Orthography fixture"
  description="Indigenous place names in every brand font and weight."
  noindex
>
  <div class="prose">
    <h1>Orthography fixture</h1>
    <p>
      Check that every character renders in the brand font, with no fallback
      glyphs, boxes or misplaced marks. Combining marks (the comma above in k̓,
      the line below in x̱) must sit on their letter.
    </p>
    {families.map((family) => (
      <section>
        <h2>{family.label} font</h2>
        {weights.map((weight) => (
          <>
            <h3>{weight.label}</h3>
            <ul
              style={`font-family: var(${family.token}); font-style: ${family.style}; font-weight: var(${weight.token});`}
            >
              {samples.map((sample) => (
                <li>{sample}</li>
              ))}
            </ul>
          </>
        ))}
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  h2 {
    font-size: var(--text-xl);
    margin-block-start: var(--space-7);
  }

  h3 {
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }

  ul {
    list-style: none;
    padding: 0;
    font-size: var(--text-3xl);
  }
</style>
