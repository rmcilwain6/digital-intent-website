---
// Valleyview grant home (SPEC 7.4, decision record 0006). Reads top to
// bottom: the bigger picture (pillar 4), past recipients, then this year's
// grant and how to apply. The apply link is added when applications open.
import { Picture } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { valleyview } from '../../../content/valleyview';
import { brand } from '../../brand/brand.config';
import EmailLink from '../../components/EmailLink.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPage } from '../../lib/pages';

const page = await getPage('valleyview');
const { Content } = await render(page);
const { hero, pillar, current } = valleyview;

const recipients = (await getCollection('recipients')).sort(
  (a, b) => b.data.year - a.data.year,
);

const dateFormat = new Intl.DateTimeFormat('en-CA', {
  dateStyle: 'long',
  timeZone: 'UTC',
});
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  socialImage="valleyview"
>
  <article class="valleyview">
    <header class="hero">
      <h1>{page.data.heading ?? page.data.title}</h1>
      <p class="headline">{hero.headline}</p>
      <div class="intro">
        <Content />
      </div>
    </header>

    <section
      id="why"
      class="band pillar"
      data-theme="digital"
      aria-labelledby="why-heading"
    >
      <div class="pillar-head">
        <p class="label">{pillar.label}</p>
        <h2 id="why-heading">{pillar.title}</h2>
      </div>
      <div class="pillar-body">
        {pillar.paragraphs.map((text) => (
          <p>{text}</p>
        ))}
      </div>
      <div class="goals">
        <h3>{pillar.goalsHeading}</h3>
        <ol>
          {pillar.goals.map((goal) => (
            <li>{goal}</li>
          ))}
        </ol>
      </div>
    </section>

    {recipients.length > 0 && (
      <section id="past" class="section" aria-labelledby="past-heading">
        <h2 id="past-heading" class="visually-hidden">
          Past recipients
        </h2>
        {recipients.map((recipient) => (
          <div class="teaser">
            <div class="portrait">
              {'src' in recipient.data.portrait ? (
                <Picture
                  class="photo"
                  src={recipient.data.portrait.src}
                  alt={recipient.data.portrait.alt}
                  formats={['avif', 'webp']}
                  quality={50}
                  widths={[320, 480, 640, 960]}
                  sizes="(min-width: 48rem) 22rem, calc(100vw - 2.5rem)"
                />
              ) : (
                <ImagePlaceholder
                  ratio="4 / 5"
                  label={recipient.data.portrait.label}
                  note={recipient.data.portrait.note}
                />
              )}
            </div>
            <div class="teaser-text">
              <p class="label">{recipient.data.cohort}</p>
              <h3>Meet {recipient.data.name}</h3>
              <p>{recipient.data.dek}</p>
              {recipient.data.published ? (
                <>
                  <blockquote>
                    <p>{recipient.data.quote}</p>
                  </blockquote>
                  <p>
                    <a class="more" href={`/valleyview/${recipient.id}/`}>
                      Read {recipient.data.name}’s story
                    </a>
                  </p>
                </>
              ) : (
                <p class="soon">
                  {recipient.data.name}’s story is coming soon.
                </p>
              )}
            </div>
          </div>
        ))}
      </section>
    )}

    <section id="apply" class="section current" aria-labelledby="apply-heading">
      <header class="current-head">
        <p class="label">{current.label}</p>
        <h2 id="apply-heading">{current.heading}</h2>
        <p class="lead">{current.intro}</p>
      </header>

      <h3>What you get</h3>
      <ul class="cards">
        {current.award.map((item) => (
          <li>
            <strong>{item.title}</strong>
            <span>{item.text}</span>
          </li>
        ))}
      </ul>

      <div class="split">
        <div>
          <h3>Who can apply</h3>
          <p>{current.eligibility}</p>
        </div>
        <div>
          <h3>What we mean by social innovation</h3>
          {current.socialInnovation.map((text) => (
            <p>{text}</p>
          ))}
        </div>
      </div>

      <div class="split">
        <div>
          <h3>How it works</h3>
          <ol class="steps">
            {current.steps.map((step) => (
              <li>
                <strong>{step.title}.</strong> {step.text}
              </li>
            ))}
          </ol>
        </div>
        <div>
          <h3>Timeline</h3>
          <ol class="timeline">
            {current.timeline.map((step) => (
              <li>
                <span class="when">
                  {step.date ? (
                    <time datetime={step.date}>
                      {dateFormat.format(new Date(step.date))}
                    </time>
                  ) : (
                    step.when
                  )}
                </span>
                <span>{step.what}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>

      {/* What a good application looks like: the questions, then our advice. */}
      <div class="split">
        <div>
          <h3>A good application answers three questions</h3>
          <ol class="questions">
            {current.questions.map((question) => (
              <li>{question}</li>
            ))}
          </ol>
        </div>
        <div>
          <h3>Our advice</h3>
          <p class="muted">{current.tipsIntro}</p>
          <ul class="tips">
            {current.tips.map((tip) => (
              <li>
                <strong>{tip.title}</strong> {tip.text}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="band apply" data-theme="digital">
        <h3>{current.apply.heading}</h3>
        <p>{current.apply.text}</p>
        <p class="apply-slot">{current.apply.pending}</p>
      </div>

      {/* Questions on the left; who runs it and how to reach us on the right. */}
      <div class="split">
        <div>
          <h3>Questions</h3>
          <div class="faq">
            {current.faq.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
        <div>
          <h3>Who’s behind it</h3>
          <p>
            {current.founders.text.replace('{organization}', brand.name)}{' '}
            <a href={current.founders.link.href}>
              {current.founders.link.label}
            </a>
            .
          </p>
          <h3>Contact and privacy</h3>
          <p>
            Questions? Email us at <EmailLink />.
          </p>
          <p>{current.privacy}</p>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .valleyview {
    --section-gap: clamp(var(--space-7), 8vw, 7rem);
  }

  .label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-label);
  }

  .muted {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  p,
  li {
    max-inline-size: var(--width-prose);
  }

  /* Hero */
  .hero {
    padding-block: var(--space-7) var(--space-6);
  }

  .hero h1 {
    margin: 0;
    font-size: var(--text-xl);
  }

  .headline {
    max-inline-size: 18ch;
    margin-block: var(--space-3) var(--space-5);
    font-size: clamp(2.25rem, 1.5rem + 4vw, 4rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
  }

  .intro {
    font-size: var(--text-lg);
  }

  /* Full-width bands in the Digital world, without page overflow. */
  .band {
    padding-block: var(--section-gap);
    box-shadow: 0 0 0 100vmax var(--color-bg);
    clip-path: inset(0 -100vmax);
  }

  .section {
    padding-block-start: var(--section-gap);
  }

  /* Pillar 4 */
  .pillar {
    display: grid;
    gap: var(--space-6);
    margin-block-start: var(--space-6);
  }

  .pillar h2 {
    margin-block: var(--space-3) 0;
    font-size: var(--text-3xl);
  }

  .pillar-body p {
    font-size: var(--text-lg);
  }

  .goals ol {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
    counter-reset: goal;
  }

  .goals li {
    padding-block-start: var(--space-3);
    border-block-start: var(--border-width) solid var(--color-border);
    counter-increment: goal;
  }

  .goals li::before {
    content: '4.' counter(goal);
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-label);
  }

  @media (width >= 60rem) {
    .pillar {
      grid-template-columns: 5fr 7fr;
      column-gap: var(--space-8);
    }

    .goals {
      grid-column: 1 / -1;
    }

    .goals ol {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Past recipients */
  .teaser {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  /* The text first and the portrait on the right, on wider screens. */
  .teaser-text {
    grid-row: 1;
  }

  /* The portrait is always 4:5, whatever the photo's own shape. */
  .portrait {
    inline-size: min(100%, 22rem);
  }

  .portrait :global(.photo) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .teaser h3 {
    margin-block: var(--space-2);
    font-size: var(--text-2xl);
  }

  blockquote {
    margin: var(--space-5) 0;
    padding-inline-start: var(--space-4);
    border-inline-start: var(--focus-width) solid var(--color-signal);
    font-size: var(--text-lg);
  }

  .soon {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .more {
    font-weight: var(--font-weight-bold);
  }

  .more::after {
    content: ' →';
  }

  @media (width >= 48rem) {
    .teaser {
      grid-template-columns: minmax(0, 1fr) 22rem;
      gap: var(--space-7);
    }
  }

  /* This year */
  .current h3 {
    margin-block: var(--space-7) var(--space-4);
  }

  .current-head h2 {
    margin-block: var(--space-2) var(--space-4);
    font-size: var(--text-3xl);
  }

  .lead {
    font-size: var(--text-lg);
  }

  .cards {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .cards li {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .cards strong {
    font-size: var(--text-xl);
  }

  .split {
    display: grid;
    column-gap: var(--space-8);
  }

  @media (width >= 48rem) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }

    .split {
      grid-template-columns: 1fr 1fr;
    }
  }

  .steps,
  .questions {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li,
  .questions li {
    position: relative;
    padding-inline-start: var(--space-7);
    counter-increment: step;
  }

  .steps li::before,
  .questions li::before {
    content: counter(step, decimal-leading-zero);
    position: absolute;
    inset-inline-start: 0;
    font-family: var(--font-mono);
    color: var(--color-label);
  }

  .questions li {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-tight);
  }

  .questions li::before {
    font-size: var(--text-base);
    line-height: inherit;
  }

  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .when {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .tips {
    display: grid;
    gap: var(--space-3);
    padding-inline-start: var(--space-5);
  }

  /* Apply band */
  .apply {
    margin-block-start: var(--section-gap);
  }

  .current .apply h3 {
    margin-block-start: 0;
    font-size: var(--text-3xl);
  }

  .apply-slot {
    display: inline-block;
    margin-block-start: var(--space-4);
    padding: var(--space-3) var(--space-5);
    border: var(--border-width) dashed var(--color-border);
    border-radius: var(--radius-lg);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* FAQ */
  .faq {
    max-inline-size: var(--width-prose);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  details {
    border-block-end: var(--border-width) solid var(--color-border);
  }

  summary {
    padding-block: var(--space-4);
    font-weight: var(--font-weight-bold);
    cursor: pointer;
  }

  details p {
    margin-block: 0 var(--space-4);
  }

  @media (width < 30rem) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
