---
// Information only until the board decides how applications are collected
// (D5). No apply button.
import { valleyview } from '../../content/valleyview';
import PageLayout from '../layouts/PageLayout.astro';
import { getPage } from '../lib/pages';

const page = await getPage('valleyview');
const dateFormat = new Intl.DateTimeFormat('en-CA', {
  dateStyle: 'long',
  timeZone: 'UTC',
});
---

<PageLayout page={page}>
  <div class="prose">
    <h2>Who can apply</h2>
    <p>{valleyview.eligibility}</p>

    <h2>Award</h2>
    <p>{valleyview.award}</p>

    <h2>What recipients get</h2>
    <ul>
      {valleyview.recipientsGet.map((item) => (
        <li>{item}</li>
      ))}
    </ul>

    <h2>What recipients agree to</h2>
    <ul>
      {valleyview.recipientsAgreeTo.map((item) => (
        <li>{item}</li>
      ))}
    </ul>

    <h2>The application questions</h2>
    <ol>
      {valleyview.questions.map((question) => (
        <li>{question}</li>
      ))}
    </ol>

    <h2>Timeline</h2>
    {valleyview.timeline.length > 0 ? (
      <ul>
        {valleyview.timeline.map((step) => (
          <li>
            {step.label}
            {step.date && (
              <>
                :{' '}
                <time datetime={step.date}>
                  {dateFormat.format(new Date(step.date))}
                </time>
              </>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p>[TK: timeline, once dates are confirmed]</p>
    )}

    <h2>How to apply</h2>
    <p>{valleyview.howToApply}</p>

    <h2>Questions</h2>
    <dl>
      {valleyview.faq.map((item) => (
        <>
          <dt>{item.question}</dt>
          <dd>{item.answer}</dd>
        </>
      ))}
    </dl>
  </div>
</PageLayout>
