---
// MOCK FOR REVIEW, not linked from the site and not indexed. Two hero board
// options for the team to choose between: /mocks/hero-whiteboard/ and
// /mocks/hero-cork/. Delete this route once one is built into Home.
import { home } from '../../../content/home';
import HeroPhotoMock from '../../components/home/HeroPhotoMock.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return (['whiteboard', 'cork'] as const).map((board) => ({
    params: { variant: `hero-${board}` },
    props: { board },
  }));
}

const { board } = Astro.props;
---

<BaseLayout
  title={`Hero mock: ${board}`}
  description="A hero layout mock for team review."
  fullWidth
  noindex
>
  <HeroPhotoMock hero={home.hero} board={board} />
</BaseLayout>
