---
import { board } from '../../content/board';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { getPage } from '../lib/pages';

const page = await getPage('board');
---

<PageLayout page={page}>
  <ul class="cards">
    {board.map((member) => (
      <li class="card">
        {'placeholder' in member.photo ? (
          <ImagePlaceholder
            ratio="4 / 5"
            label="Portrait"
            note={member.photo.note}
          />
        ) : (
          <img
            class="portrait"
            src={member.photo.src}
            loading="lazy"
            alt={member.photo.alt}
          />
        )}
        <h2>{member.name}</h2>
        <p>{member.role}</p>
        <p>{member.region}</p>
        {member.industry && <p>{member.industry}</p>}
        {member.expertise && <p>{member.expertise.join(', ')}</p>}
        {member.bio && <p>{member.bio}</p>}
        {member.link && <a href={member.link.href}>{member.link.label}</a>}
      </li>
    ))}
  </ul>
</PageLayout>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  h2 {
    font-size: var(--text-lg);
  }

  /*
   * Same 4:5 frame as the placeholder, so the card does not shift while the
   * photo loads and any portrait size crops to fit.
   */
  .portrait {
    display: block;
    inline-size: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-md);
  }
</style>
