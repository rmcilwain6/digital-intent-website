---
// Board (SPEC 7.3): member cards beside a map of BC. Without JavaScript the
// map is a still overview and every card is readable. With it, scrolling to a
// card, opening its background or focusing it eases the map towards that
// member's town and the districts they lead (D14 permitting). The map is
// labelled with place names; several members can share a place.
import { render } from 'astro:content';
import { board, boardSettings } from '../../content/board';
import BoardMap, {
  type MapDistricts,
  type MapPlace,
} from '../components/board/BoardMap.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { district, focusFor, pathBounds, placePoint, union } from '../lib/map';
import { getPage } from '../lib/pages';

const page = await getPage('board');
const { Content } = await render(page);
const { showRegionalLeads } = boardSettings;
const listFormat = new Intl.ListFormat('en-CA', { type: 'conjunction' });

const slug = (name: string) =>
  name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const members = board.map((member) => {
  const id = slug(member.name);
  const point = placePoint(member.place);
  const districts = showRegionalLeads
    ? (member.leads ?? []).map((n) => district(n))
    : [];
  // A gentle zoom: never closer than about 2.5 times the overview.
  const focus = focusFor(
    union(
      districts.map((d) => pathBounds(d.d)),
      [point],
    ),
    420,
    2.5,
  );
  return { member, id, point, districts, focus };
});

// One marker per place, shared by everyone who lives there.
const places: MapPlace[] = [];
for (const m of members) {
  const existing = places.find((p) => p.name === m.member.place);
  if (existing) existing.members.push(m.id);
  else places.push({ name: m.member.place, point: m.point, members: [m.id] });
}

const mapDistricts: MapDistricts[] = members.flatMap((m) =>
  m.districts.map((d) => ({ member: m.id, d: d.d })),
);
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  fullWidth
>
  <div class="board-page" data-board>
    <div class="layout">
      <header class="intro">
        <p class="tk-marker">
          [TK: fictional placeholder board members for the map prototype. Real
          details are added only with each member's agreement.]
        </p>
        {showRegionalLeads && (
          <p class="tk-marker">
            [TK: regional leads are shown for the prototype. Not public until
            the board decides D14.]
          </p>
        )}
        <h1>{page.data.heading ?? page.data.title}</h1>
        <Content />
      </header>

      <div class="map-panel">
        {/*
          Phones with JavaScript: the person being read, beside the map. A
          visual copy of each card's heading, so it is hidden from assistive
          technology, which reads the cards themselves.
        */}
        <div class="people" aria-hidden="true">
          {members.map(({ member, id }) => (
            <div class="person" data-person={id}>
              {'placeholder' in member.photo ? (
                <span class="person-photo person-photo-placeholder">
                  Portrait
                </span>
              ) : (
                <img class="person-photo" src={member.photo.src} alt="" />
              )}
              <p class="person-name">{member.name}</p>
              <p class="person-meta">{member.role}</p>
              <p class="person-meta">{member.region}</p>
            </div>
          ))}
        </div>
        <div class="map-slot">
          <BoardMap places={places} districts={mapDistricts} />
        </div>
      </div>

      <div class="list">
        <ol class="members">
          {members.map(({ member, id, districts, focus }) => (
            <li
              class="card"
              id={id}
              data-card
              data-member={id}
              data-focus={JSON.stringify(focus)}
            >
              <div class="photo">
                {'placeholder' in member.photo ? (
                  <ImagePlaceholder
                    ratio="4 / 5"
                    label="Portrait"
                    note={member.photo.note}
                  />
                ) : (
                  <img
                    class="portrait"
                    src={member.photo.src}
                    loading="lazy"
                    alt={member.photo.alt}
                  />
                )}
              </div>
              <div class="text">
                <h2>{member.name}</h2>
                <dl class="facts identity">
                  <div>
                    <dt>Board role</dt>
                    <dd>{member.role}</dd>
                  </div>
                  <div>
                    <dt>Location</dt>
                    <dd>{member.region}</dd>
                  </div>
                </dl>
                <dl class="facts">
                  {member.focus && (
                    <div class="wide">
                      <dt>Focus</dt>
                      <dd>{member.focus}</dd>
                    </div>
                  )}
                  {districts.length > 0 && (
                    <div class="wide">
                      <dt>Regions</dt>
                      <dd>
                        School Districts{' '}
                        {listFormat.format(
                          districts.map((d) => `${d.number} ${d.name}`),
                        )}
                      </dd>
                    </div>
                  )}
                </dl>
                {member.affiliations && (
                  <ul class="affiliations">
                    {member.affiliations.map((a) => (
                      <li>
                        {'placeholder' in a.logo ? (
                          <span class="logo-placeholder" aria-hidden="true">
                            Logo
                          </span>
                        ) : (
                          <img class="logo" src={a.logo.src} alt="" />
                        )}
                        <span>
                          <span class="affiliation-label">{a.label}</span>{' '}
                          {a.name}
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
                {(member.industry ||
                  member.expertise ||
                  member.bio ||
                  member.link) && (
                  <details>
                    <summary>Background</summary>
                    {member.industry && <p>{member.industry}</p>}
                    {member.expertise && (
                      <p>Expertise: {listFormat.format(member.expertise)}</p>
                    )}
                    {member.bio && <p>{member.bio}</p>}
                    {member.link && (
                      <p>
                        <a href={member.link.href}>{member.link.label}</a>
                      </p>
                    )}
                  </details>
                )}
              </div>
            </li>
          ))}
        </ol>
        <p class="credits">
          Map data: Natural Earth (public domain).
          {showRegionalLeads &&
            ' School district boundaries: DataBC. Contains information licensed under the Open Government Licence – British Columbia.'}
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Eases the board map towards the member being read. An enhancement only:
  // the page is complete without it. Moves the map by transform; the motion
  // tokens make the change instant under prefers-reduced-motion.
  interface Focus {
    scale: number;
    cx: number;
    cy: number;
  }

  // Phones get the app-like view; must match the CSS breakpoint.
  const phone = window.matchMedia('(max-width: 63.99rem)');

  function init(root: HTMLElement) {
    const svg = root.querySelector<SVGSVGElement>('.board-map svg');
    const camera = root.querySelector<SVGGElement>('[data-camera]');
    const reset = root.querySelector<HTMLButtonElement>('[data-map-reset]');
    const panel = root.querySelector<HTMLElement>('.map-panel');
    const peopleBox = root.querySelector<HTMLElement>('.people');
    const header = document.querySelector<HTMLElement>('.site-header');
    if (!svg || !camera || !reset || !panel || !peopleBox) return;
    const markers = [...root.querySelectorAll<SVGGElement>('.marker')];
    const districts = [...root.querySelectorAll<SVGPathElement>('.district')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const people = [...root.querySelectorAll<HTMLElement>('[data-person]')];
    const focuses = new Map(
      cards.map((card) => [
        card.dataset.member ?? '',
        JSON.parse(card.dataset.focus ?? 'null') as Focus,
      ]),
    );
    const [, , mapWidth = 1000, mapHeight = 866] = (
      svg.getAttribute('viewBox') ?? ''
    )
      .split(' ')
      .map(Number);

    let active: string | null | undefined;

    // The screen point, in map units, where the focus should land: the middle
    // of the map, or on phones the middle of the area right of the person.
    function target(): [number, number] {
      const box = svg!.getBoundingClientRect();
      const k = Math.min(box.width / mapWidth, box.height / mapHeight);
      const offsetX = (box.width - mapWidth * k) / 2;
      const offsetY = (box.height - mapHeight * k) / 2;
      let x = box.width / 2;
      if (phone.matches && active) {
        const covered = peopleBox!.getBoundingClientRect().right - box.left;
        x = covered + (box.width - covered) / 2;
      }
      return [(x - offsetX) / k, (box.height / 2 - offsetY) / k];
    }

    function place() {
      const focus = active ? focuses.get(active) : undefined;
      let scale = 1;
      let x = 0;
      let y = 0;
      if (focus) {
        const [tx, ty] = target();
        scale = focus.scale;
        x = tx - scale * focus.cx;
        y = ty - scale * focus.cy;
      }
      camera!.style.transform = `translate(${x}px, ${y}px) scale(${scale})`;
      for (const marker of markers) {
        const mx = Number(marker.dataset.x) * scale + x;
        const my = Number(marker.dataset.y) * scale + y;
        marker.style.transform = `translate(${mx}px, ${my}px)`;
      }
    }

    function show(id: string | null) {
      if (id === active) return;
      active = id;
      for (const marker of markers) {
        const here = (marker.dataset.members ?? '').split(' ');
        marker.classList.toggle('is-active', id !== null && here.includes(id));
      }
      for (const d of districts) {
        d.classList.toggle('is-active', d.dataset.member === id);
      }
      for (const card of cards) {
        card.classList.toggle('is-active', card.dataset.member === id);
      }
      for (const person of people) {
        person.classList.toggle('is-active', person.dataset.person === id);
      }
      peopleBox!.classList.toggle('has-person', id !== null);
      reset!.hidden = id === null;
      place();
    }

    // Scrolling: the card crossing a thin band just below the pinned panel
    // on phones, or near the middle of the screen on wide ones, is the one
    // being read. Ignored until the visitor scrolls, so the page opens on
    // the whole province.
    let scrolled = false;
    let observer: IntersectionObserver | undefined;

    function watch() {
      // Phones: pin the panel under the pinned header.
      const headerHeight = phone.matches && header ? header.offsetHeight : 0;
      root.style.setProperty('--board-header-height', `${headerHeight}px`);
      const top = phone.matches
        ? headerHeight + panel!.offsetHeight + 16
        : window.innerHeight * 0.45;
      const bottom = Math.max(window.innerHeight - top - 48, 0);
      observer?.disconnect();
      observer = new IntersectionObserver(
        (entries) => {
          if (!scrolled) return;
          for (const entry of entries) {
            if (entry.isIntersecting) {
              show((entry.target as HTMLElement).dataset.member ?? null);
            }
          }
        },
        { rootMargin: `-${top}px 0px -${bottom}px 0px` },
      );
      cards.forEach((card) => observer!.observe(card));
      place();
    }

    show(null);
    watch();
    window.addEventListener('resize', watch);

    window.addEventListener(
      'scroll',
      () => {
        scrolled = true;
        if (window.scrollY < 80) show(null);
      },
      { passive: true },
    );

    // Opening a member's background or moving focus into their card.
    for (const card of cards) {
      const id = card.dataset.member ?? null;
      card.querySelector('details')?.addEventListener('toggle', (event) => {
        if ((event.target as HTMLDetailsElement).open) show(id);
      });
      card.addEventListener('focusin', () => show(id));
    }

    reset.addEventListener('click', () => show(null));
  }

  const root = document.querySelector<HTMLElement>('[data-board]');
  if (root) init(root);
</script>

<style>
  .board-page {
    padding-inline: var(--space-4);
  }

  @media (min-width: 64rem) {
    .board-page {
      padding-inline: var(--space-6);
    }
  }

  .intro {
    max-width: var(--width-prose);
    padding-block: var(--space-6) var(--space-5);
  }

  .tk-marker {
    display: inline-block;
    margin-block: 0 var(--space-2);
    padding: var(--space-1) var(--space-2);
    border: var(--border-width) dashed var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .layout {
    display: grid;
    gap: var(--space-5);
  }

  /* Phones: a short strip pinned to the top while the list scrolls under it. */
  .map-panel {
    position: sticky;
    inset-block-start: 0;
    z-index: 1;
    height: 38vh;
    padding-block: var(--space-2);
    background: var(--color-bg);
  }

  /*
   * Wide screens: intro and list on the left, the map filling the right side
   * from the top of the page, so the whole province shows on arrival. The
   * panel height leaves room for the site header above it.
   */
  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      grid-template-areas:
        'intro map'
        'list map';
      grid-template-rows: auto 1fr;
      column-gap: var(--space-7);
      row-gap: 0;
    }

    .intro {
      grid-area: intro;
    }

    .map-panel {
      grid-area: map;
      align-self: start;
      height: calc(100vh - var(--space-8));
      padding-block: var(--space-5);
    }

    .list {
      grid-area: list;
    }
  }

  .members {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The person stack exists for phones with JavaScript only. */
  .people {
    display: none;
  }

  .map-slot {
    height: 100%;
  }

  /*
   * Phones with JavaScript: an app-like view. The site header and the map
   * panel stay pinned; only the details below them scroll. The map starts as
   * the whole province, full width. When a member is being read, their
   * photo, name, role and town fade in over the left of the map, and the
   * script centres the map in the space beside them. Each card's photo, name,
   * role and location are visually hidden but stay in place for assistive
   * technology. Without JavaScript, the full cards show as normal.
   */
  @media (max-width: 63.99rem) {
    :global(.js .site-header) {
      position: sticky;
      inset-block-start: 0;
      z-index: 2;
      background: var(--color-bg);
    }

    :global(.js) .map-panel {
      inset-block-start: var(--board-header-height, 0);
      height: clamp(12rem, 30vh, 17rem);
      border-block-end: var(--border-width) solid var(--color-border);
    }

    :global(.js) .people {
      position: absolute;
      inset-block: var(--space-2);
      inset-inline-start: 0;
      z-index: 1;
      display: grid;
      inline-size: 38%;
      padding: var(--space-3);
      border-radius: var(--radius-lg) 0 0 var(--radius-lg);
      background: var(--color-bg);
      opacity: 0;
      transition: opacity var(--duration-slow) var(--ease-standard);
    }

    :global(.js) .people.has-person {
      opacity: 1;
    }

    :global(.js) .person {
      grid-area: 1 / 1;
      margin: 0;
      opacity: 0;
      transition: opacity var(--duration-slow) var(--ease-standard);
    }

    :global(.js) .person.is-active {
      opacity: 1;
    }

    :global(.js) .person-photo {
      inline-size: 4.5rem;
    }

    :global(.js) .card {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--space-2) 0 0;
      border: 0;
      border-radius: 0;
    }

    :global(.js) .card + .card {
      border-block-start: var(--border-width) solid var(--color-border);
      padding-block-start: var(--space-5);
    }

    :global(.js) .card .photo {
      display: none;
    }

    :global(.js) .card h2,
    :global(.js) .card .identity {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    :global(.js) .card.is-active {
      border-color: var(--color-border);
    }
  }

  .person-photo {
    display: block;
    inline-size: 100%;
    max-block-size: 22vh;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .person-photo-placeholder {
    display: grid;
    place-items: center;
    border: var(--border-width) dashed var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .person-name {
    margin: var(--space-2) 0 0;
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-tight);
  }

  .person-meta {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Room after the last card so it can reach the middle of the screen. */
  .list {
    padding-block-end: 40vh;
  }

  .card {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    scroll-margin-block-start: 40vh;
  }

  /* Narrow screens: portrait above the text so the text keeps its width. */
  @media (max-width: 40rem) {
    .card {
      grid-template-columns: minmax(0, 1fr);
    }

    .photo {
      max-inline-size: 8.5rem;
    }
  }

  .card.is-active {
    border-color: var(--color-accent);
  }

  .text > :first-child {
    margin-block-start: 0;
  }

  h2 {
    font-size: var(--text-xl);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-4);
    margin: var(--space-3) 0;
  }

  .facts .wide {
    grid-column: 1 / -1;
  }

  dt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  dd {
    margin: 0;
  }

  .affiliations {
    display: grid;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .affiliations li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .logo,
  .logo-placeholder {
    flex: none;
    inline-size: var(--space-7);
    block-size: var(--space-7);
    border-radius: var(--radius-sm);
  }

  .logo {
    object-fit: contain;
  }

  .logo-placeholder {
    display: grid;
    place-items: center;
    border: var(--border-width) dashed var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .affiliation-label {
    display: block;
    color: var(--color-text-muted);
  }

  summary {
    color: var(--color-link);
    font-weight: var(--font-weight-bold);
    cursor: pointer;
  }

  .portrait {
    display: block;
    inline-size: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .credits {
    margin-block-start: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
