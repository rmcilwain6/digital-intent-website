---
// Indigenous outreach (SPEC 7.9, decision record 0007): our land
// acknowledgement, for all of BC and for each place we are based, then our
// commitments. A natural map of the province carries the sense of place and
// will gain a point for each school we work with. It holds the site's only
// full land acknowledgement; the footer carries a short one that links here.
// Copy is in content/outreach.ts. Drafts show a visible [TK] marker until the
// outreach lead approves them.
import { outreach } from '../../content/outreach';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import OutreachMap from '../components/OutreachMap.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { getPage } from '../lib/pages';

const page = await getPage('indigenous-outreach');
const { heroImage, acknowledgement, map, commitments } = outreach;
const [intro, ...rest] = acknowledgement.paragraphs;

const draftMarker = '[TK: draft copy, needs human approval]';

const monthFormat = new Intl.DateTimeFormat('en-CA', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const formatMonth = (date: string) =>
  monthFormat.format(new Date(`${date}-01`));
---

<PageLayout page={page}>
  <div class="hero-image">
    <ImagePlaceholder {...heroImage} />
  </div>

  <section class="acknowledgement" aria-labelledby="acknowledgement">
    <div class="ack-text">
      <h2 id="acknowledgement">{acknowledgement.heading}</h2>
      {acknowledgement.draft && <p class="draft-marker">{draftMarker}</p>}
      <p class="ack-lede">{intro}</p>
      {rest.map((text) => (
        <p>{text}</p>
      ))}
    </div>

    <figure class="map">
      <OutreachMap visits={map.visits} />
      <figcaption>{map.caption}</figcaption>
    </figure>
  </section>

  <ul class="regions" aria-label="Where we are based">
    {acknowledgement.regions.map(({ region, text, image }) => (
      <li>
        <ImagePlaceholder {...image} />
        <h3>{region}</h3>
        <p>{text}</p>
      </li>
    ))}
  </ul>

  {map.visits.length > 0 && (
    <section class="visits" aria-labelledby="visits">
      <h2 id="visits">Schools we have worked with</h2>
      <ol>
        {map.visits.map((visit) => (
          <li>
            <p class="visit-name">
              {visit.school}, {visit.community}
            </p>
            <p class="visit-date">
              <time datetime={visit.date}>{formatMonth(visit.date)}</time>
            </p>
            <p>{visit.summary}</p>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section class="commitments" aria-labelledby="commitments">
    <h2 id="commitments">{commitments.heading}</h2>
    {commitments.draft && <p class="draft-marker">{draftMarker}</p>}
    <ol>
      {commitments.items.map((item) => (
        <li>{item}</li>
      ))}
    </ol>
  </section>
</PageLayout>

<style>
  h2 {
    margin-block: 0 var(--space-4);
  }

  .hero-image {
    margin-block-start: var(--space-6);
  }

  .draft-marker {
    display: inline-block;
    margin-block: 0 var(--space-4);
    padding: var(--space-1) var(--space-2);
    border: var(--border-width) dashed var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Text beside a large map on wide screens; stacked on narrow ones. */
  .acknowledgement {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-7);
    align-items: center;
    margin-block-start: var(--space-8);
  }

  .ack-text p {
    max-inline-size: var(--width-prose);
  }

  .ack-lede {
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  .map {
    margin: 0;
  }

  .map figcaption {
    margin-block-start: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .regions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
  }

  .regions h3 {
    margin: var(--space-4) 0 var(--space-2);
  }

  .regions p {
    margin: 0;
  }

  .visits {
    margin-block-start: var(--space-8);
  }

  .visits ol {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .visits p {
    margin: 0;
  }

  .visit-name {
    font-weight: var(--font-weight-bold);
  }

  .visit-date {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .commitments {
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-7);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .commitments ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-7);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: commitment;
  }

  .commitments li {
    counter-increment: commitment;
    padding-block-start: var(--space-3);
    border-block-start: var(--border-width) solid var(--color-accent);
    max-inline-size: var(--width-prose);
  }

  .commitments li::before {
    content: counter(commitment, decimal-leading-zero);
    display: block;
    margin-block-end: var(--space-2);
    color: var(--color-label);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  @media (width < 56rem) {
    .acknowledgement {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }

    .regions {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (width < 40rem) {
    .commitments ol {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
