---
// Indigenous outreach (SPEC 7.9, decision record 0007). The page opens on
// our land acknowledgement for all of BC, beside a natural map of the
// province that gains a point for each school, Nation or band we work with.
// Then a territorial acknowledgement for each place we are based, in rows
// that alternate text and a landscape photo, then our commitments. It holds
// the site's only full land acknowledgement; the footer carries a short one
// that links here. Copy is in content/outreach.ts. Drafts show a visible
// [TK] marker until the outreach lead approves them.
import { organization } from '../../content/organization';
import { Picture } from 'astro:assets';
import { outreach } from '../../content/outreach';
import OutreachMap from '../components/OutreachMap.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/pages';

const page = await getPage('indigenous-outreach');
const { acknowledgement, map, commitments } = outreach;
const pillar = organization.pillars[commitments.pillar.number - 1];
if (!pillar) {
  throw new Error(`No pillar ${commitments.pillar.number} in organization.ts`);
}

const monthFormat = new Intl.DateTimeFormat('en-CA', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const formatMonth = (date: string) =>
  monthFormat.format(new Date(`${date}-01`));
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <article>
    <section class="acknowledgement" aria-labelledby="acknowledgement">
      <div class="ack-text">
        <h1 id="acknowledgement">{acknowledgement.heading}</h1>
        {acknowledgement.paragraphs.map((text) => (
          <p class="ack-lede">{text}</p>
        ))}
      </div>

      <figure class="map">
        <OutreachMap visits={map.visits} />
        <figcaption>{map.caption}</figcaption>
      </figure>
    </section>

    <section class="regions" aria-labelledby="regions">
      <h2 id="regions">{acknowledgement.regionsHeading}</h2>
      <ul>
        {acknowledgement.regions.map(({ region, text, photo }) => (
          <li>
            <div class="region-text">
              <h3>{region}</h3>
              <p>{text}</p>
            </div>
            <figure
              class:list={[
                'region-photo',
                { portrait: photo.src.height > photo.src.width },
              ]}
            >
              <Picture
                class="photo"
                src={photo.src}
                alt={photo.alt}
                formats={['avif', 'webp']}
                quality={50}
                widths={[480, 720, 960, 1280]}
                sizes={
                  photo.src.height > photo.src.width
                    ? '(min-width: 56rem) 17rem, min(17rem, calc(100vw - 2.5rem))'
                    : '(min-width: 56rem) 30rem, calc(100vw - 2.5rem)'
                }
              />
              <figcaption>
                {photo.caption} · {photo.taken}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>

    {map.visits.length > 0 && (
      <section class="visits" aria-labelledby="visits">
        <h2 id="visits">Who we have worked with</h2>
        <ol>
          {map.visits.map((visit) => (
            <li>
              <p class="visit-name">
                {visit.name}, {visit.community}
              </p>
              <p class="visit-date">
                <time datetime={visit.date}>{formatMonth(visit.date)}</time>
              </p>
              <p>{visit.summary}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="commitments" aria-labelledby="commitments">
      <div class="commitments-list">
        <h2 id="commitments">{commitments.heading}</h2>
        <ol>
          {commitments.items.map((item) => (
            <li>{item}</li>
          ))}
        </ol>
      </div>

      {/*
        Part of the commitments, not a sidebar to the page, so a plain block
        rather than an aside (a nested complementary landmark). Its visible
        label is enough.
      */}
      <div class="pillar">
        <p class="pillar-label">{commitments.pillar.label}</p>
        <p class="pillar-title">{pillar}</p>
        <p>{commitments.foundation}</p>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  h2 {
    margin-block: 0 var(--space-5);
  }

  /* The acknowledgement beside a large map; stacked on narrow screens. */
  .acknowledgement {
    display: grid;
    margin-block-start: var(--space-6);
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-7);
    align-items: center;
  }

  .ack-text h1 {
    margin-block: 0 var(--space-5);
  }

  .ack-lede {
    max-inline-size: var(--width-prose);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  .map {
    margin: 0;
  }

  .map figcaption {
    max-inline-size: 36ch;
    margin: var(--space-3) auto 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-align: center;
  }

  /* Rows that alternate: text then image, image then text. */
  .regions {
    margin-block-start: var(--space-8);
  }

  .regions ul {
    display: grid;
    gap: var(--space-7);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * The photo is the smaller column, so it supports the text rather than
   * outweighing it. Kamloops starts with the photo on the left.
   */
  .regions li {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--space-7);
    align-items: center;
  }

  .regions li:nth-child(odd) .region-photo {
    order: -1;
  }

  .regions li:nth-child(even) {
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
  }

  .region-photo {
    margin: 0;
  }

  .region-photo :global(.photo) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-lg);
  }

  /* A tall photo would dwarf its text on wide screens, so it is narrower. */
  .region-photo.portrait {
    justify-self: center;
    inline-size: min(100%, 17rem);
  }

  .region-photo figcaption {
    margin-block-start: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .regions h3 {
    margin: 0 0 var(--space-3);
  }

  .regions p {
    max-inline-size: var(--width-prose);
    margin: 0;
  }

  .visits {
    margin-block-start: var(--space-8);
  }

  .visits ol {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .visits p {
    margin: 0;
  }

  .visit-name {
    font-weight: var(--font-weight-bold);
  }

  .visit-date {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* The list on the left; the pillar it falls under across from it. */
  .commitments {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-7);
    align-items: start;
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-7);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .commitments ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: commitment;
  }

  .commitments li {
    counter-increment: commitment;
    display: grid;
    grid-template-columns: 3ch minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-block-start: var(--border-width) solid var(--color-accent);
    max-inline-size: var(--width-prose);
  }

  .commitments li::before {
    content: counter(commitment, decimal-leading-zero);
    color: var(--color-label);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .pillar {
    padding: var(--space-5);
    border-inline-start: var(--border-width) solid var(--color-accent);
  }

  .pillar p {
    margin: 0;
  }

  .pillar-label {
    color: var(--color-label);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .pillar .pillar-title {
    margin-block: var(--space-2) var(--space-4);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-tight);
  }

  @media (width < 56rem) {
    .acknowledgement,
    .regions li,
    .regions li:nth-child(even),
    .commitments {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }

    /* Stacked, every region reads name and text first, then the photo. */
    .regions li:nth-child(odd) .region-photo {
      order: 0;
    }
  }
</style>
