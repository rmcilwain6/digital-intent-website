---
// Home. Its section-by-section layout comes with #7; this is the frame and
// the content wiring. The <title> is the organization name alone.
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/pages';

const page = await getPage('home');
const { Content } = await render(page);
---

<BaseLayout description={page.data.description}>
  <div class="prose">
    <h1>{page.data.heading ?? page.data.title}</h1>
    <Content />
  </div>
</BaseLayout>
