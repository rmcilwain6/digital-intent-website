---
// Home: a guided walk through full-width sections, each with its own job and
// call to action (SPEC 7.1, record 0004). Copy lives in content/home.ts and
// content/organization.ts; the section order is data (D30). The <title> is
// the organization name alone.
import { home } from '../../content/home';
import { valleyview } from '../../content/valleyview';
import { brand } from '../brand/brand.config';
import BcMap from '../components/BcMap.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeSection from '../components/home/HomeSection.astro';
import LibrarySection from '../components/home/LibrarySection.astro';
import QuestionBreak from '../components/home/QuestionBreak.astro';
import WhatWeDo from '../components/home/WhatWeDo.astro';
import WhyWeExist from '../components/home/WhyWeExist.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/pages';

const page = await getPage('home');
const { sections } = home;

// Bands alternate tone after the question break, whatever the order. The
// first is on the page's own paper, so the break flows straight into it.
const tone = (index: number) => (index % 2 === 0 ? 'base' : 'surface');
---

<BaseLayout description={page.data.description} fullWidth>
  <HomeHero hero={home.hero} />
  <QuestionBreak question={home.question} />

  {home.order.map((key, index) => {
    if (key === 'problem') {
      return (
        <WhyWeExist id={key} section={sections.problem} tone={tone(index)} />
      );
    }
    if (key === 'library') {
      return (
        <LibrarySection
          id={key}
          section={sections.library}
          tone={tone(index)}
        />
      );
    }
    if (key === 'mission') {
      return (
        <WhatWeDo id={key} section={sections.mission} tone={tone(index)} />
      );
    }
    const section = sections[key];
    return (
      <HomeSection
        id={key}
        heading={section.heading}
        lead={'lead' in section ? section.lead : undefined}
        body={section.body}
        cta={section.cta}
        draft={section.draft}
        tone={tone(index)}
      >
        {key === 'map' && (
          <div class="map-layout">
            <div>
              <h3>{sections.map.regionsHeading}</h3>
              <ul>
                {brand.regions.map((region) => (
                  <li>{region}</li>
                ))}
              </ul>
            </div>
            <BcMap />
          </div>
        )}

        {key === 'valleyview' && (
          <div class="prose">
            <p>{valleyview.current.eligibility}</p>
            <h3>{sections.valleyview.questionsHeading}</h3>
            <ol>
              {valleyview.current.questions.map((question) => (
                <li>{question}</li>
              ))}
            </ol>
            <p>{valleyview.current.apply.text}</p>
          </div>
        )}
      </HomeSection>
    );
  })}
</BaseLayout>

<style>
  .map-layout {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  @media (min-width: 48rem) {
    .map-layout {
      grid-template-columns: 1fr 2fr;
    }
  }
</style>
