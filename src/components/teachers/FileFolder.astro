---
// The lessons, kept in one paper file folder with a tab per lesson. Choosing
// a tab brings that lesson's sheet to the front.
//
// Without JavaScript (rule 4) the tabs are links to each lesson and every
// sheet shows, one after another. The script turns the links into tabs
// (WAI-ARIA tabs pattern: arrow keys, Home and End move between tabs) and
// keeps the chosen lesson in the address, so a link to #lesson-<slug> opens
// that tab.
import type { Lesson } from '../../schemas/teachers';
import LessonSheet from './LessonSheet.astro';

interface Props {
  lessons: Lesson[];
  /** Accessible name for the row of tabs. */
  label: string;
}

const { lessons, label } = Astro.props;
const number = (index: number) => String(index + 1).padStart(2, '0');
---

<div class="folder" data-folder>
  <nav class="tabs" aria-label={label}>
    <ul data-tablist>
      {lessons.map((lesson, index) => (
        <li>
          <a
            class="tab"
            href={`#lesson-${lesson.slug}`}
            id={`tab-${lesson.slug}`}
            data-tab
          >
            <span class="tab-number" aria-hidden="true">
              {number(index)}
            </span>
            {lesson.tab ?? lesson.title}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="body">
    {lessons.map((lesson, index) => (
      <section
        class="panel"
        id={`lesson-${lesson.slug}`}
        aria-labelledby={`lesson-${lesson.slug}-title`}
        data-panel
      >
        <LessonSheet lesson={lesson} index={index} />
      </section>
    ))}
  </div>
</div>

<script>
  for (const folder of document.querySelectorAll<HTMLElement>(
    '[data-folder]',
  )) {
    const list = folder.querySelector<HTMLElement>('[data-tablist]');
    const tabs = Array.from(
      folder.querySelectorAll<HTMLAnchorElement>('[data-tab]'),
    );
    const panels = Array.from(
      folder.querySelectorAll<HTMLElement>('[data-panel]'),
    );
    if (!list || tabs.length === 0 || tabs.length !== panels.length) continue;

    // The nav landmark only makes sense for the links; as tabs, the list
    // takes the name.
    const nav = list.closest('nav');
    list.setAttribute('role', 'tablist');
    list.setAttribute('aria-label', nav?.getAttribute('aria-label') ?? '');
    nav?.removeAttribute('aria-label');
    nav?.setAttribute('role', 'presentation');

    tabs.forEach((tab, i) => {
      const panel = panels[i]!;
      tab.parentElement?.setAttribute('role', 'presentation');
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', panel.id);
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tab.id);
      panel.tabIndex = 0;
    });

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[i]!.hidden = !selected;
      });
      if (focus) tabs[index]!.focus();
    };

    const fromHash = () =>
      panels.findIndex((panel) => `#${panel.id}` === window.location.hash);

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', (event) => {
        event.preventDefault();
        select(i);
        history.replaceState(null, '', `#${panels[i]!.id}`);
      });
    });

    list.addEventListener('keydown', (event) => {
      const current = tabs.findIndex((tab) => tab === document.activeElement);
      if (current === -1) return;
      const last = tabs.length - 1;
      const next = {
        ArrowRight: current === last ? 0 : current + 1,
        ArrowLeft: current === 0 ? last : current - 1,
        Home: 0,
        End: last,
      }[event.key];
      if (next === undefined) return;
      event.preventDefault();
      select(next, true);
      history.replaceState(null, '', `#${panels[next]!.id}`);
    });

    window.addEventListener('hashchange', () => {
      const index = fromHash();
      if (index !== -1) select(index);
    });

    folder.dataset.enhanced = '';
    select(Math.max(fromHash(), 0));
  }
</script>

<style>
  /* The row of tabs. Its bottom line is the folder's top edge; the chosen tab
     covers it, so the tab and the folder read as one piece of card. On
     narrow screens the row scrolls sideways on its own. */
  .tabs ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-1) 0 0;
    overflow-x: auto;
    list-style: none;
    box-shadow: inset 0 calc(-1 * var(--border-width)) 0 var(--color-border);
    scrollbar-width: thin;
  }

  li {
    display: flex;
    flex: none;
  }

  .tab {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    padding: var(--space-2) var(--space-5) var(--space-2) var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-block-end: 0;
    border-start-start-radius: var(--radius-lg);
    border-start-end-radius: var(--radius-lg);
    background: var(--color-bg);
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
    white-space: nowrap;
    text-decoration: none;
  }

  /* Kept inside the scrolling row, so it is not clipped. */
  .tab:focus-visible {
    outline-offset: calc(-1 * var(--focus-width) - var(--focus-offset));
  }

  .tab:hover {
    background: var(--color-card);
  }

  .tab[aria-selected='true'] {
    background: var(--color-surface);
  }

  .tab-number {
    color: var(--color-label);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: var(--font-weight-regular);
  }

  .body {
    display: grid;
    gap: var(--space-7);
    padding: var(--space-6) var(--space-6) var(--space-7);
    border: var(--border-width) solid var(--color-border);
    border-block-start: 0;
    border-end-start-radius: var(--radius-md);
    border-end-end-radius: var(--radius-md);
    background: var(--color-surface);
    isolation: isolate;
  }

  /* Without JavaScript every sheet shows; a hidden attribute wins once the
     script has made them tabs. */
  .panel[hidden] {
    display: none;
  }

  .panel:focus-visible {
    outline-offset: var(--space-2);
  }

  @media (width < 48rem) {
    .body {
      padding: var(--space-4) var(--space-4) var(--space-6);
    }

    .tab {
      padding-inline: var(--space-3) var(--space-4);
    }
  }
</style>
