---
// One downloadable lesson, drawn as a paper file folder: a tab with the
// format, the title and what students do, then the details typed in mono
// like a file listing, and a direct download. No sign-up in front of it
// (rule 1). While the file is a [TK] note, the download shows as text.
import { isPlaceholder } from '../../lib/placeholder';
import type { Resource } from '../../schemas/teachers';

interface Props {
  resource: Resource;
}

const { resource } = Astro.props;
const pending = isPlaceholder(resource.file);
const extension = pending ? '' : resource.file.split('.').pop();
const fileName = `${resource.slug}.${extension || 'pdf'}`;
const updated = new Intl.DateTimeFormat('en-CA', {
  dateStyle: 'medium',
  timeZone: 'UTC',
}).format(new Date(resource.updated));
const unit = resource.format === 'Slides' ? 'slides' : 'pages';
---

<article class="folder" aria-labelledby={`${resource.slug}-title`}>
  <span class="tab">{resource.format}</span>
  {resource.example && <p class="example">[TK: example entry]</p>}
  <h3 id={`${resource.slug}-title`}>{resource.title}</h3>
  <p class="summary">{resource.summary}</p>

  <dl class="specs">
    <div>
      <dt>grades</dt>
      <dd>{resource.grades}</dd>
    </div>
    <div>
      <dt>fits</dt>
      <dd>{resource.subjects.join(', ')}</dd>
    </div>
    <div>
      <dt>time</dt>
      <dd>{resource.length}</dd>
    </div>
  </dl>

  <div class="foot">
    <p class="file">
      <span>{fileName}</span>
      <span>
        {resource.pages} {unit} · {resource.size} · {updated}
      </span>
    </p>
    {pending ? (
      <span class="download pending" aria-disabled="true">
        Download
      </span>
    ) : (
      <a class="download" href={resource.file} download>
        Download
        <span class="visually-hidden">
          {resource.title}, {resource.format}, {resource.size}
        </span>
      </a>
    )}
  </div>
</article>

<style>
  /* The tab sits on the folder's top edge, so the card leaves room above. */
  .folder {
    position: relative;
    display: flex;
    flex-direction: column;
    margin-block-start: 1.75rem;
    padding: var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-start-start-radius: 0;
    border-radius: var(--radius-md);
    background: var(--color-card);
  }

  .tab {
    position: absolute;
    inset-block-end: 100%;
    inset-inline-start: calc(-1 * var(--border-width));
    padding: var(--space-1) var(--space-4) 0;
    border: var(--border-width) solid var(--color-border);
    border-block-end: 0;
    border-start-start-radius: var(--radius-md);
    border-start-end-radius: var(--radius-md);
    background: var(--color-card);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5rem;
  }

  /* Covers the folder's top border under the tab, so the two read as one. */
  .tab::after {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    block-size: var(--border-width);
    background: var(--color-card);
    content: '';
  }

  .example {
    margin: 0 0 var(--space-2);
    color: var(--color-label);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .summary {
    margin: 0 0 var(--space-4);
  }

  .specs {
    display: grid;
    gap: var(--space-1);
    margin: 0 0 var(--space-5);
    font-size: var(--text-sm);
  }

  .specs div {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--space-2);
  }

  dt {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6rem;
  }

  dd {
    margin: 0;
  }

  /* Pushed to the bottom, so downloads line up across a row of folders. */
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: end;
    justify-content: space-between;
    margin-block-start: auto;
    padding-block-start: var(--space-4);
    border-block-start: var(--border-width) dashed var(--color-border);
  }

  .file {
    display: grid;
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .download {
    padding: var(--space-1) var(--space-4);
    border: var(--border-width) solid var(--color-text);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
  }

  a.download:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .download.pending {
    border-color: var(--color-border);
    color: var(--color-text-muted);
  }

  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
