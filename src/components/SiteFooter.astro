---
// Site footer, Digital world (design system: website frame). Layout B from
// the footer review (Reed, November 26, 2026): on the left, "Next stops"
// continue the reader's path, with a short land acknowledgement below them
// that links to the Indigenous outreach page (decision record 0007). On the
// right, the organization, its starting regions, contact and links. A slim
// bar holds the licence, with the photo and map credits behind a Credits
// toggle (a native disclosure, so it works without JavaScript). The page
// receipt comes in its own pull request (SPEC 8.2).
import { site } from '../../content/site';
import { brand } from '../brand/brand.config';
import BcOutline from './BcOutline.astro';
import EmailLink from './EmailLink.astro';

const trim = (path: string) => path.replace(/\/+$/, '') || '/';
const currentPath = trim(Astro.url.pathname);
const stops = site.nextStops.filter((stop) => trim(stop.href) !== currentPath);
const regions = new Intl.ListFormat('en-CA', { type: 'conjunction' }).format(
  brand.regions,
);
---

<footer class="site-footer" data-theme="digital">
  <div class="container">
    <div class="main">
      <div class="journey">
        {stops.length > 0 && (
          <section class="next-stops" aria-labelledby="next-stops-heading">
            <h2 id="next-stops-heading">Next stops</h2>
            <ul>
              {stops.map((stop) => (
                <li>
                  <a href={stop.href}>
                    <span class="stop-path">{trim(stop.href)}</span>
                    <span>
                      <span class="stop-name">{stop.label}</span>
                      <span class="stop-text">{stop.description}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <div class="acknowledgement">
          <BcOutline width={64} />
          <p>
            {site.acknowledgement.text}{' '}
            <a href={site.acknowledgement.link.href}>
              {site.acknowledgement.link.label}
            </a>
          </p>
        </div>
      </div>

      <div class="org">
        <img
          class="logo"
          src={brand.logo.onDark}
          alt={brand.name}
          width={brand.logo.width}
          height={brand.logo.height}
        />
        <p class="muted">
          {site.regionsIntro} {regions}.
        </p>
        <p>
          <EmailLink />
        </p>
        <nav class="footer-nav" aria-label="Footer">
          <ul>
            {site.footerNav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    <details class="fine-print">
      <summary>
        <span>
          {brand.name} · {site.licence}
        </span>
        <span class="toggle" aria-hidden="true">
          <span class="show">Credits</span>
          <span class="hide">Hide credits</span>
        </span>
        <span class="visually-hidden">Credits</span>
      </summary>
      <p>{site.photoCredit}</p>
      <p>{site.mapCredit}</p>
    </details>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-7) 0;
  }

  /* Left: where to go next and the acknowledgement. Right: who we are. */
  .main {
    display: grid;
    gap: var(--space-7);
    padding-block-end: var(--space-6);
  }

  h2 {
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-regular);
  }

  .next-stops ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .next-stops a {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-block-start: var(--border-width) solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
  }

  .next-stops a:hover .stop-name {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .stop-path {
    padding-block-start: 0.2em;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-label);
  }

  .stop-name {
    display: block;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-tight);
  }

  .stop-text {
    display: block;
    margin-block-start: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-code);
  }

  .acknowledgement {
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
    padding-block-start: var(--space-5);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .acknowledgement :global(svg) {
    flex: none;
  }

  .acknowledgement p {
    margin: 0;
    max-inline-size: var(--width-prose);
    font-size: var(--text-code);
  }

  .acknowledgement a {
    color: var(--color-text);
    text-underline-offset: 0.2em;
  }

  .org {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .org p {
    margin: 0;
    max-inline-size: 40ch;
    font-size: var(--text-code);
  }

  .logo {
    --logo-height: 2.125rem;
    block-size: var(--logo-height);
    inline-size: auto;
    margin-inline-start: calc(-0.3 * var(--logo-height));
  }

  .muted {
    color: var(--color-text-muted);
  }

  .footer-nav {
    align-self: stretch;
    padding-block-start: var(--space-4);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .footer-nav ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-code);
  }

  .footer-nav a {
    color: var(--color-text);
    text-decoration: none;
  }

  .footer-nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* The bar: licence on the left, the Credits toggle on the right. */
  .fine-print {
    border-block-start: var(--border-width) solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  summary {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-4);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .toggle {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .toggle::before {
    content: '▸';
    display: inline-block;
    margin-inline-end: 0.5em;
  }

  .fine-print[open] .toggle::before {
    content: '▾';
  }

  .hide,
  .fine-print[open] .show {
    display: none;
  }

  .fine-print[open] .hide {
    display: inline;
  }

  summary:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--space-1);
  }

  .fine-print p {
    margin: 0 0 var(--space-2);
  }

  .fine-print p:last-child {
    margin-block-end: var(--space-5);
  }

  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (width >= 64rem) {
    .main {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  @media (width < 30rem) {
    .next-stops a {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
