---
// Manual theme toggle (SPEC T7, D10), shown as a switch: on means dark.
// Hidden without JavaScript, when the site just follows the system setting.
// The stored value is the visitor's theme preference only, kept in their own
// browser (rule 2). A choice that matches the system setting is not stored,
// so the site goes back to following the system.
---

<button
  type="button"
  class="theme-toggle"
  role="switch"
  aria-checked="false"
  aria-label="Toggle Theme: dark"
  data-theme-toggle
>
  <span class="label">Toggle Theme</span>
  <span class="track" aria-hidden="true">
    <span class="thumb"></span>
  </span>
</button>

<script>
  // Must match the key read by the inline script in BaseLayout.astro.
  const STORAGE_KEY = 'theme';
  const root = document.documentElement;
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    '[data-theme-toggle]',
  );

  const system = () => (systemDark.matches ? 'dark' : 'light');
  const current = () => root.dataset.theme ?? system();

  const sync = () => {
    const checked = String(current() === 'dark');
    buttons.forEach((button) => button.setAttribute('aria-checked', checked));
  };

  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      const followSystem = next === system();
      if (followSystem) {
        delete root.dataset.theme;
      } else {
        root.dataset.theme = next;
      }
      try {
        if (followSystem) {
          localStorage.removeItem(STORAGE_KEY);
        } else {
          localStorage.setItem(STORAGE_KEY, next);
        }
      } catch {
        // Storage blocked: the choice lasts for this page only.
      }
      sync();
    }),
  );

  systemDark.addEventListener('change', sync);
  sync();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-2);
    border: none;
    border-radius: var(--radius-md);
    background: none;
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .track {
    /* Inner width (track minus padding and borders) minus the thumb. */
    --thumb-travel: calc(var(--space-4) + var(--space-1));
    display: inline-flex;
    align-items: center;
    inline-size: calc(var(--space-6) + var(--space-3));
    block-size: var(--space-5);
    padding: var(--space-1);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--space-5);
    background: var(--color-surface);
  }

  .thumb {
    inline-size: calc(
      var(--space-5) - var(--space-2) - 2 * var(--border-width)
    );
    block-size: calc(var(--space-5) - var(--space-2) - 2 * var(--border-width));
    border-radius: 50%;
    background: var(--color-text);
    transition: transform var(--duration-base) var(--ease-standard);
  }

  /*
   * The thumb follows the active theme in CSS, so it is in the right place on
   * first paint, before the script runs.
   */
  :global(:root[data-theme='dark']) .track {
    background: var(--color-accent);
  }

  :global(:root[data-theme='dark']) .thumb {
    background: var(--color-on-accent);
    transform: translateX(var(--thumb-travel));
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .track {
      background: var(--color-accent);
    }

    :global(:root:not([data-theme='light'])) .thumb {
      background: var(--color-on-accent);
      transform: translateX(var(--thumb-travel));
    }
  }

  :global(html:not(.js)) .theme-toggle {
    display: none;
  }
</style>
