---
// Site header, Digital world (design system: website frame). Sticks to the
// top of the screen. Wide screens show the navigation inline, with the
// current page as selected text. Phones get the "index" key, which opens a
// navy panel with one key per page (design system: Keycap).
//
// The phone menu is a <details> element, so it opens and closes without
// JavaScript (rule 4). The script adds Escape to close and keeps focus inside
// the menu while it is open.
import { site } from '../../content/site';
import { brand } from '../brand/brand.config';
import EmailLink from './EmailLink.astro';
import Transect from './Transect.astro';

const trim = (path: string) => path.replace(/\/+$/, '') || '/';
const currentPath = trim(Astro.url.pathname);
const isCurrent = (href: string) => trim(href) === currentPath;
// The phone menu's order and full-row keys are set in content/site.ts.
const pages = [site.home, ...site.primaryNav];
const menuItems = site.phoneMenu.map((key) => ({
  ...pages.find((item) => item.href === key.href)!,
  wide: key.wide ?? false,
}));
const wideNav = site.primaryNav.filter((item) => !item.phoneOnly);
const privacy = site.footerNav.find((item) => item.href === '/privacy/');
---

<header class="site-header" data-theme="digital">
  <div class="container">
    <div class="bar">
      <a class="logo" href={site.home.href}>
        <img
          src={brand.logo.onDark}
          alt={`${brand.shortName}, home`}
          width={brand.logo.width}
          height={brand.logo.height}
        />
      </a>

      <nav class="nav-wide" aria-label="Primary">
        <ul>
          {wideNav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <details class="menu" data-menu>
        <summary aria-label="Index: site menu">
          <span class="key">
            index
            <span class="terrace" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
          </span>
        </summary>
        <nav class="menu-panel" aria-label="Primary">
          <ul class="page-keys">
            {menuItems.map((item) => (
              <li class:list={{ wide: item.wide }}>
                <a
                  class="page-key"
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  <span class="page-name">{item.label}</span>
                  {/* Decoration: screen readers announce the page name only. */}
                  <span class="page-path" aria-hidden="true">
                    {trim(item.href)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p class="menu-foot">
            {privacy && <a href={privacy.href}>{privacy.label}</a>}
            <span aria-hidden="true">·</span>
            <EmailLink />
          </p>
        </nav>
      </details>
    </div>
  </div>
  {/* Full width, edge to edge, so it runs as far as anything below it. */}
  <Transect />
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
  const summary = menu?.querySelector('summary');
  if (menu && summary) {
    const links = () =>
      Array.from(menu.querySelectorAll<HTMLAnchorElement>('.menu-panel a'));

    menu.addEventListener('keydown', (event) => {
      if (!menu.open) return;
      if (event.key === 'Escape') {
        menu.open = false;
        summary.focus();
        return;
      }
      if (event.key !== 'Tab') return;
      // Keep focus on the key and the menu links while the menu is open.
      const all = links();
      const first = summary;
      const last = all[all.length - 1];
      if (event.shiftKey && document.activeElement === first && last) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 10;
    padding-block-start: var(--space-5);
  }

  /*
   * Short screens, such as a phone on its side or 200% zoom: let it scroll
   * away. Still positioned, so the phone menu panel sits under it.
   */
  @media (height < 30rem) {
    .site-header {
      position: relative;
    }
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin-block-end: var(--space-3);
  }

  .logo {
    --logo-height: 2.5rem;
    display: block;
    margin-inline-start: calc(-0.3 * var(--logo-height));
    line-height: 0;
  }

  .logo img {
    block-size: var(--logo-height);
    inline-size: auto;
  }

  /* Wide navigation */
  .nav-wide {
    margin-inline-start: auto;
  }

  .nav-wide ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-wide a {
    padding: var(--space-1) var(--space-2);
    color: var(--color-text);
    text-decoration: none;
  }

  .nav-wide a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* The current page is selected text, the Digital world's emphasis. */
  .nav-wide [aria-current='page'] {
    background: var(--color-highlight);
    color: var(--color-on-highlight);
  }

  /*
   * Forced colours (Windows High Contrast) drop the highlight background, which
   * would leave the current page looking like every other link. Use the
   * system's own selected-text colours so it still reads as selected.
   */
  @media (forced-colors: active) {
    .nav-wide [aria-current='page'] {
      forced-color-adjust: none;
      background: Highlight;
      color: HighlightText;
    }
  }

  /* Phone menu */
  .menu {
    display: none;
    margin-inline-start: auto;
  }

  summary {
    display: inline-flex;
    align-items: flex-start;
    justify-content: center;
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    padding-block-start: var(--space-1);
    border-radius: var(--radius-lg);
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .key {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.375rem var(--space-3);
    border: var(--border-width) solid var(--color-key-edge);
    border-block-start-color: var(--color-key-edge-top);
    border-block-end: 3px solid var(--color-key-lip);
    border-radius: 6px;
    background: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.4;
    transition: transform var(--duration-press) var(--ease-standard);
  }

  /* Open: the key stays pressed down. Tapping dips it a little further. */
  .menu[open] .key {
    border-block-end: var(--border-width) solid var(--color-key-edge);
    margin-block-end: 2px;
    background: var(--color-bg);
    box-shadow: inset 0 2px 0 var(--color-key-lip);
    transform: translateY(2px);
  }

  summary:active .key {
    transform: translateY(3px);
  }

  .terrace {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    inline-size: 1rem;
  }

  .terrace > span {
    display: block;
    block-size: 2px;
    border-radius: 1px;
    background: currentColor;
  }

  .terrace > span:nth-child(1) {
    inline-size: 62%;
  }

  .terrace > span:nth-child(2) {
    inline-size: 80%;
  }

  .terrace > span:nth-child(3) {
    inline-size: 100%;
  }

  /* The panel fills the screen below the header (100% is the header's height). */
  .menu-panel {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    block-size: calc(100dvh - 100%);
    padding: var(--space-4) var(--space-gutter) var(--space-5);
    overflow-y: auto;
    background: var(--color-bg);
  }

  .menu[open] .menu-panel {
    animation: menu-in var(--duration-base) var(--ease-enter);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(calc(-1 * var(--motion-distance-sm)));
    }
  }

  /* Keys in a row share a height, so a two-line name keeps the row even. */
  .page-keys {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .page-keys .wide {
    grid-column: 1 / -1;
  }

  .page-keys li {
    display: flex;
  }

  .page-keys .page-key {
    flex: 1;
  }

  .page-key {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: var(--space-4);
    border: var(--border-width) solid var(--color-key-edge);
    border-block-start-color: var(--color-key-edge-top);
    border-block-end: 4px solid var(--color-key-lip);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition: transform var(--duration-press) var(--ease-standard);
  }

  .page-key:active {
    border-block-end-width: var(--border-width);
    margin-block-start: 3px;
  }

  /* The current page stays pressed down. */
  .page-key[aria-current='page'] {
    border-block-end-width: var(--border-width);
    margin-block-start: 3px;
    background: var(--color-bg);
    box-shadow: inset 0 2px 0 var(--color-key-lip);
  }

  .page-key:focus-visible {
    outline-offset: calc(-1 * var(--focus-width));
  }

  .page-name {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-tight);
  }

  .page-path {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  /* The current page's path is the one in signal green. */
  .page-key[aria-current='page'] .page-path {
    color: var(--color-signal);
  }

  .menu-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: auto 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .key,
    .page-key {
      transition: none;
    }

    .menu[open] .menu-panel {
      animation: none;
    }
  }

  @media (width < 48rem) {
    .site-header {
      padding-block-start: var(--space-3);
    }

    .bar {
      margin-block-end: var(--space-2);
    }

    .logo {
      --logo-height: 1.875rem;
    }

    .nav-wide {
      display: none;
    }

    .menu {
      display: block;
    }
  }
</style>
