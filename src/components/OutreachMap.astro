---
// Natural map of British Columbia for the Indigenous outreach page (SPEC
// 7.9), in the Analog house style of the team map (design system: Map): the
// province alone, framed on BC, with nothing drawn outside its border. It
// shows the land, lakes and major rivers and the three places we are based,
// with no school districts, roads or towns. Schools, Nations and bands we
// have worked with are added as points, with their agreement
// (content/outreach.ts); points mark a place, never Nation boundaries.
// Drawn at build time from data/map/bc-map.json: no JavaScript, no map
// service, no runtime requests.
import { brand } from '../brand/brand.config';
import { bcFrame, map, placePoint } from '../lib/map';
import type { Visit } from '../schemas/outreach';

interface Props {
  visits: readonly Visit[];
}

const { visits } = Astro.props;

// Labels sit east of the marker unless they would run off the province
// frame. Source Code Pro is 0.6em a character; checked at the phone size.
const regions = brand.regions.map((name) => {
  const [x, y] = placePoint(name);
  const left = x + 24 + name.length * 0.6 * 36 > bcFrame.x + bcFrame.width;
  return { name, x, y, left };
});

const regionList = new Intl.ListFormat('en-CA', { type: 'conjunction' }).format(
  brand.regions,
);
const visitText =
  visits.length === 0
    ? 'No schools or communities are marked yet.'
    : `${visits.length} ${visits.length === 1 ? 'place is' : 'places are'} marked; the list below names each one.`;
---

<svg
  class="outreach-map"
  viewBox={[bcFrame.x, bcFrame.y, bcFrame.width, bcFrame.height]
    .map((n) => n.toFixed(1))
    .join(' ')}
  role="img"
  aria-label={`Map of British Columbia showing its lakes and major rivers, with ${regionList} marked. ${visitText}`}
  focusable="false"
>
  <defs>
    <clipPath id="outreach-map-bc">
      <path d={map.bc}></path>
    </clipPath>
  </defs>
  <path class="land" d={map.bc}></path>
  <g clip-path="url(#outreach-map-bc)">
    <path class="lakes" d={map.lakes}></path>
    <path class="rivers" d={map.rivers}></path>
  </g>
  {visits.map((visit) => (
    <circle class="visit" cx={visit.at[0]} cy={visit.at[1]} r="6"></circle>
  ))}
  {regions.map((r) => (
    <g class="region">
      <circle cx={r.x} cy={r.y} r="5"></circle>
      <text
        x={r.left ? r.x - 14 : r.x + 14}
        y={r.y}
        dy="0.35em"
        text-anchor={r.left ? 'end' : 'start'}
      >
        {r.name}
      </text>
    </g>
  ))}
</svg>

<style>
  .outreach-map {
    --label-size: 18px;
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .land {
    fill: var(--color-surface);
    stroke: var(--color-border);
    stroke-width: 1;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .lakes {
    fill: var(--color-accent);
    fill-opacity: 0.16;
  }

  .rivers {
    fill: none;
    stroke: var(--color-accent);
    stroke-opacity: 0.4;
    stroke-width: 0.9;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .region circle {
    fill: var(--color-text);
    stroke: var(--color-surface);
    stroke-width: 2px;
  }

  .region text {
    fill: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--label-size);
    paint-order: stroke;
    stroke: var(--color-surface);
    stroke-width: 6px;
    stroke-linejoin: round;
  }

  .visit {
    fill: var(--color-marker);
    stroke: var(--color-surface);
    stroke-width: 2px;
  }

  /* The map is drawn small on phones, so labels are larger in map units. */
  @media (width < 40rem) {
    .outreach-map {
      --label-size: 32px;
    }

    .region circle {
      r: 8px;
    }
  }
</style>
