---
// The BC map on Home (SPEC 7.1): the Analog house map (design system:
// MapAnalog), the same map as the team page. School districts as dotted
// lines, the starting regions as pen-red dots with their districts outlined,
// and a close-up of the southwest, like an atlas inset, where Victoria and
// Vancouver sit too close together to read at the province's scale.
//
// Static: no zoom, hover or JavaScript. Drawn at build time as inline SVG
// from data/map/bc-map.json, so it sends no requests. The regions and their
// districts are listed in the page text too, so the map is never the only way
// to learn them.
import { brand } from '../brand/brand.config';
import { regionDistricts } from '../../content/team';
import {
  bcFrame,
  type Box,
  kmPerUnit,
  map,
  placePoint,
  scaleBarKm,
  union,
} from '../lib/map';

interface Props {
  /** How to read the map, shown under it. */
  caption: string;
  /** Mono label on the close-up. */
  insetLabel: string;
  /** Data credit, shown under the caption. */
  credit: string;
}

const { caption, insetLabel, credit } = Astro.props;

const box = (b: Box) => [b.x, b.y, b.width, b.height].join(' ');

// The close-up: the detailed southwest layer, cut to the province's shape.
const detail = map.detail.frame;
const insetHeight = detail.height;
const insetWidth = (insetHeight * bcFrame.width) / bcFrame.height;
const inset: Box = {
  x: detail.x + (detail.width - insetWidth) / 2,
  y: detail.y,
  width: insetWidth,
  height: insetHeight,
};
// The main map's frame: the province, stretched just enough to show the
// close-up's frame whole (it reaches a little past the province's southern
// edge), plus room for the frame's stroke.
const sheetFrame = union([bcFrame], [[inset.x, inset.y + inset.height + 2]]);

const inInset = ([x, y]: [number, number], margin = 0) =>
  x > inset.x + margin &&
  x < inset.x + inset.width - margin &&
  y > inset.y + margin &&
  y < inset.y + inset.height - margin;

const leads = Object.values(regionDistricts).flat();
const outline = (list: typeof map.districts) =>
  list.filter((d) => leads.includes(d.number));

const regions = brand.regions.map((name) => {
  const point = placePoint(name);
  return { name, point, close: inInset(point) };
});

// District numbers on the close-up, ours in bold. A number that a town's
// dot or name would cover is left off; the page text names those districts.
// Sizes match the close-up's CSS (Source Code Pro is 0.6em a character).
type Rect = [number, number, number, number];
const townLabels: Rect[] = regions
  .filter((r) => r.close)
  .map((r) => [
    r.point[0] - 2,
    r.point[1] - 4,
    r.point[0] + 3 + r.name.length * 0.6 * 7.5,
    r.point[1] + 4,
  ]);
const overlaps = (a: Rect, b: Rect) =>
  a[0] < b[2] && b[0] < a[2] && a[1] < b[3] && b[1] < a[3];
const numbers = map.detail.districts
  .filter((d) => inInset(d.label as [number, number], 4))
  .filter((d) => {
    const [x, y] = d.label as [number, number];
    const half = (String(d.number).length * 0.6 * 6) / 2;
    const rect: Rect = [x - half, y - 3, x + half, y + 3];
    return !townLabels.some((t) => overlaps(t, rect));
  })
  .map((d) => ({
    number: d.number,
    at: d.label as [number, number],
    lead: leads.includes(d.number),
  }));

// Scale bar in the bottom-right corner, which is outside the province.
const scaleKm = scaleBarKm(bcFrame.width * kmPerUnit);
const scaleLength = scaleKm / kmPerUnit;
const scaleRight = bcFrame.x + bcFrame.width - 30;
const scaleLeft = scaleRight - scaleLength;
const scaleY = bcFrame.y + bcFrame.height - 22;

const list = (names: string[]) =>
  new Intl.ListFormat('en-CA', { type: 'conjunction' }).format(names);
const closeNames = regions.filter((r) => r.close).map((r) => r.name);
const label =
  `Map of BC’s school districts, with ${list([...brand.regions])} marked and their districts outlined.` +
  (closeNames.length ? ` A close-up shows ${list(closeNames)}.` : '');
---

<figure class="bc-map">
  <div class="sheet" role="img" aria-label={label}>
    <svg viewBox={box(sheetFrame)} aria-hidden="true" focusable="false">
      <path class="land" d={map.bc}></path>
      <path class="district-lines" d={map.districtLines}></path>
      {outline(map.districts).map((d) => (
        <path class="lead" d={d.d} />
      ))}
      <rect
        class="inset-frame"
        x={inset.x}
        y={inset.y}
        width={inset.width}
        height={inset.height}
      ></rect>
      {regions.map((r) => (
        <g class="region">
          <circle cx={r.point[0]} cy={r.point[1]} r="7" />
          {!r.close && (
            <text x={r.point[0] + 15} y={r.point[1]} dy="0.35em">
              {r.name}
            </text>
          )}
        </g>
      ))}
      <path
        class="scale"
        d={`M${scaleLeft} ${scaleY - 6}V${scaleY}H${scaleRight}V${scaleY - 6}`}
      ></path>
      <text
        class="scale-label"
        x={(scaleLeft + scaleRight) / 2}
        y={scaleY - 12}
      >
        {scaleKm} km
      </text>
    </svg>

    <div class="inset">
      <p class="inset-label">{insetLabel}</p>
      <svg viewBox={box(inset)} aria-hidden="true" focusable="false">
        <path class="land" d={map.detail.land}></path>
        <path class="district-lines" d={map.detail.districtLines}></path>
        {outline(map.detail.districts).map((d) => (
          <path class="lead" d={d.d} />
        ))}
        {numbers.map((n) => (
          <text
            class:list={['number', { 'is-lead': n.lead }]}
            x={n.at[0]}
            y={n.at[1]}
            dy="0.35em"
          >
            {n.number}
          </text>
        ))}
        {regions
          .filter((r) => r.close)
          .map((r) => (
            <g class="region">
              <circle cx={r.point[0]} cy={r.point[1]} r="1.5" />
              <text x={r.point[0] + 3} y={r.point[1]} dy="0.35em">
                {r.name}
              </text>
            </g>
          ))}
      </svg>
    </div>
  </div>
  <figcaption>
    {caption}
    <span class="credit">{credit}</span>
  </figcaption>
</figure>

<style>
  .bc-map {
    container-type: inline-size;
    max-inline-size: 48rem;
    margin: 0 0 0 auto;
  }

  .sheet {
    position: relative;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .land {
    fill: var(--color-surface);
    stroke: var(--color-border);
    stroke-width: 1;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* School districts as dotted lines, as on the team map. */
  .district-lines {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 0.8;
    stroke-dasharray: 1.5 2.5;
    vector-effect: non-scaling-stroke;
  }

  /* The districts around each starting region, in pen red. */
  .lead {
    fill: none;
    stroke: var(--color-marker);
    stroke-width: 1.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .inset-frame,
  .scale {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .region circle {
    fill: var(--color-marker);
    stroke: var(--color-surface);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  text {
    font-family: var(--font-mono);
    fill: var(--color-text);
    paint-order: stroke;
    stroke: var(--color-surface);
    stroke-linejoin: round;
  }

  .region text {
    font-size: var(--label-size, 22px);
    font-weight: var(--font-weight-bold);
    stroke-width: 6px;
  }

  .scale-label {
    font-size: var(--scale-size, 18px);
    fill: var(--color-text-muted);
    stroke: none;
    text-anchor: middle;
  }

  /* The close-up hangs off the bottom-left corner, over the open sea. */
  .inset {
    position: absolute;
    inset-inline-start: 0;
    inset-block-end: calc(-1 * var(--space-7));
    inline-size: 34%;
    border: var(--border-width) solid var(--color-border);
    background: var(--band-bg, var(--color-bg));
  }

  .inset-label {
    margin: 0;
    padding: var(--space-1) var(--space-3);
    border-block-end: var(--border-width) solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-tight);
  }

  .inset .region text {
    font-size: 7.5px;
    stroke-width: 2px;
  }

  .inset .number {
    font-size: 6px;
    fill: var(--color-text-muted);
    stroke-width: 1.6px;
    text-anchor: middle;
  }

  .inset .number.is-lead {
    fill: var(--color-text);
    font-weight: var(--font-weight-bold);
  }

  figcaption {
    margin-block-start: var(--space-4);
    padding-inline-start: 36%;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .credit {
    display: block;
    margin-block-start: var(--space-1);
  }

  /*
   * A narrow map (phones, or stacked below the text), sized on the map's own
   * width, not the screen's. The map is drawn small, so its labels are larger
   * in map units. The close-up moves below the map at about the size it has
   * on desktop, so its labels keep their desktop sizes. The side-by-side
   * layout never gets this narrow (its map is at least 35rem).
   */
  @container (max-width: 34rem) {
    .sheet {
      --label-size: 32px;
      --scale-size: 26px;
    }

    .inset {
      position: static;
      inline-size: min(100%, 16rem);
      margin-block-start: var(--space-4);
    }

    figcaption {
      padding-inline-start: 0;
    }
  }

  /* Phones: smaller again, so the main map's labels grow again in map units. */
  @container (max-width: 26rem) {
    .sheet {
      --label-size: 44px;
      --scale-size: 36px;
    }
  }
</style>
