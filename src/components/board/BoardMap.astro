---
// Board map (SPEC 7.3): the Analog house map of BC (design system: Map) with
// a marker for each town where board members live. It is the main thing on
// the page; the text beside it supports it.
//
// One map, one camera. Without JavaScript it is a still view of the whole
// province. With it, the Board page script moves the camera to the member
// being read: a gentle zoom on their part of the province, and closer only
// where towns sit close together (the Lower Mainland and the Capital Region),
// where the close-up coastline (data/map: detail) fades in. While D14 allows,
// the districts the member leads are outlined in pen red.
//
// The camera and the markers move by transform, everything else by opacity.
// Markers and labels sit outside the camera so they keep their size; the
// script moves them to match. The motion tokens make every change instant
// under reduced motion. The map is not a control: nothing on it can be
// clicked.
//
// Drawn at build time as inline SVG: no tiles, no map service, no runtime
// requests. The page shows the data credits (data/map/README.md).
import { bcFrame, type Box, map } from '../../lib/map';

export interface MapPlace {
  name: string;
  point: [number, number];
}

export interface MapDistrict {
  number: number;
  name: string;
  d: string;
  label: [number, number];
}

export interface MapView {
  /** The member this view belongs to. */
  member: string;
  /** The town the view is about. */
  place: string;
  /** What the view shows, in map units. */
  box: Box;
  /** Districts the member leads (empty unless D14 allows). */
  leads: MapDistrict[];
}

interface Props {
  places: MapPlace[];
  views: MapView[];
}

const { places, views } = Astro.props;

// A view uses the close-up layers when it lies wholly inside them.
const within = (box: Box, outer: Box) =>
  box.x >= outer.x &&
  box.y >= outer.y &&
  box.x + box.width <= outer.x + outer.width &&
  box.y + box.height <= outer.y + outer.height;

const asDistricts = (list: typeof map.districts): MapDistrict[] =>
  list.map((d) => ({
    number: d.number,
    name: d.name,
    d: d.d,
    label: d.label as [number, number],
  }));
const detailDistricts = asDistricts(map.detail.districts);

// The camera for each view: scale k, then move so the view's box fills the
// frame. The script applies it as translate(tx, ty) scale(k).
const cameras = Object.fromEntries(
  views.map((view) => {
    const k = bcFrame.width / view.box.width;
    return [
      view.member,
      {
        k: +k.toFixed(4),
        tx: +(bcFrame.x - k * view.box.x).toFixed(2),
        ty: +(bcFrame.y - k * view.box.y).toFixed(2),
        detail: within(view.box, map.detail.frame),
      },
    ];
  }),
);

// Close views draw their lead districts from the close-up layer. A district
// label that would sit on the member's town moves just below it.
const outlines = views.flatMap((view) => {
  const camera = cameras[view.member];
  const k = camera?.k ?? 1;
  const town = places.find((p) => p.name === view.place)?.point;
  return view.leads.map((lead) => {
    const d = camera?.detail
      ? (detailDistricts.find((x) => x.number === lead.number) ?? lead)
      : lead;
    const crowded =
      town !== undefined &&
      Math.hypot(d.label[0] - town[0], d.label[1] - town[1]) * k < 48;
    return {
      ...d,
      member: view.member,
      label: crowded
        ? ([town[0], town[1] + 30 / k] as [number, number])
        : d.label,
    };
  });
});

// Labels sit east of the marker unless they would run off the province
// frame. Source Code Pro is 0.6em a character; checked at the phone size.
const labelLeft = ({ name, point }: MapPlace) =>
  point[0] + 24 + name.length * 0.6 * 44 > bcFrame.x + bcFrame.width;

const at = ([x, y]: [number, number]) => `translate(${x}px, ${y}px)`;
---

<div class="board-map" data-board-map data-cameras={JSON.stringify(cameras)}>
  <svg
    viewBox={[bcFrame.x, bcFrame.y, bcFrame.width, bcFrame.height]
      .map((n) => n.toFixed(1))
      .join(' ')}
    preserveAspectRatio="xMidYMid meet"
    focusable="false"
    role="img"
    aria-label={`Map of British Columbia marking where board members live: ${places.map((p) => p.name).join(', ')}`}
  >
    <g class="camera" data-camera>
      <g class="province" data-province>
        <path class="land" d={map.bc} />
        <path class="district-lines" d={map.districtLines} />
      </g>
      <g class="detail" data-detail>
        <path class="land" d={map.detail.land} />
        <path class="district-lines" d={map.detail.districtLines} />
      </g>
      {outlines.map((d) => (
        <path class="lead" d={d.d} data-member={d.member} />
      ))}
    </g>
    {outlines.map((d) => (
      <g
        class="pin district-name"
        data-member={d.member}
        data-x={d.label[0]}
        data-y={d.label[1]}
        style={{ transform: at(d.label) }}
      >
        <text text-anchor="middle" dy="0.35em">
          SD {d.number}
        </text>
      </g>
    ))}
    {places.map((p) => {
      const left = labelLeft(p);
      return (
        <g
          class="pin marker"
          data-place={p.name}
          data-x={p.point[0]}
          data-y={p.point[1]}
          style={{ transform: at(p.point) }}
        >
          <circle r="6" />
          <text
            x={left ? -14 : 14}
            dy="0.35em"
            text-anchor={left ? 'end' : 'start'}
          >
            {p.name}
          </text>
        </g>
      );
    })}
  </svg>
</div>

<style>
  .board-map {
    --label-size: 18px;
    --district-size: 14px;
    height: 100%;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .camera {
    transform-box: view-box;
    transform-origin: 0 0;
  }

  .camera,
  .pin {
    transition: transform var(--duration-slower) var(--ease-standard);
  }

  .pin {
    transform-box: view-box;
    transform-origin: 0 0;
  }

  .land {
    fill: var(--color-surface);
    stroke: var(--color-border);
    stroke-width: 1;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* School districts as dotted lines (design system: MapAnalog). */
  .district-lines {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 0.8;
    stroke-dasharray: 1.5 2.5;
    vector-effect: non-scaling-stroke;
  }

  /*
   * On close views the close-up coastline takes over from the province
   * outline, which is too rough at that scale.
   */
  .province {
    transition: opacity var(--duration-slower) var(--ease-standard);
  }

  .province.is-off {
    opacity: 0;
  }

  .detail,
  .lead,
  .district-name {
    opacity: 0;
    transition: opacity var(--duration-slower) var(--ease-standard);
  }

  .detail.is-on,
  .lead.is-on,
  .district-name.is-on {
    opacity: 1;
  }

  /* The districts a member leads, outlined in pen red. */
  .lead {
    fill: none;
    stroke: var(--color-marker);
    stroke-width: 1.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  text {
    font-family: var(--font-mono);
    paint-order: stroke;
    stroke: var(--color-surface);
    stroke-linejoin: round;
  }

  .marker text {
    fill: var(--color-text);
    font-size: var(--label-size);
    stroke-width: 6px;
  }

  .marker circle {
    fill: var(--color-text);
    stroke: var(--color-surface);
    stroke-width: 2px;
  }

  /* The town of the member being read: a pen-red dot and a bold name. */
  .marker.is-here circle {
    fill: var(--color-marker);
  }

  .marker.is-here text {
    font-weight: var(--font-weight-bold);
  }

  .district-name text {
    fill: var(--color-marker);
    font-size: var(--district-size);
    font-weight: var(--font-weight-bold);
    stroke-width: 5px;
  }

  /*
   * Phones: the map is drawn small, so markers and labels are larger in map
   * units, and while a member is being read only their town is named.
   */
  @media (max-width: 63.99rem) {
    .board-map {
      --label-size: 36px;
      --district-size: 28px;
    }

    .marker circle {
      r: 10px;
    }

    .board-map:global(.has-member) .marker:not(.is-here) text {
      display: none;
    }
  }
</style>
