---
// Board map (SPEC 7.3): the province with a marker for each town where board
// members live, labelled with the place name. Several members can share a
// marker. While D14 allows, the school districts a member leads are shaded
// when that member is selected. Drawn at build time as inline SVG: no tiles,
// no map service, no runtime requests.
//
// Without JavaScript it is a still overview. The Board page script moves the
// "camera" group to ease in on one member. Markers sit outside the camera so
// they keep their size; the script moves them to match. Both move by
// transform only, and the motion tokens make it instant under reduced motion.
// The page shows the data credits (data/map/README.md) below the list.
import { map, mapHeight, mapWidth } from '../../lib/map';

export interface MapPlace {
  name: string;
  point: [number, number];
  /** Ids of the members who live here. */
  members: string[];
}

export interface MapDistricts {
  member: string;
  d: string;
}

interface Props {
  places: MapPlace[];
  districts: MapDistricts[];
}

const { places, districts } = Astro.props;

// Labels go west of the marker (towards the coast) unless that would run off
// the map, and east unless that would. Width is a rough estimate.
const labelLeft = ({ name, point: [x] }: MapPlace) => {
  const width = name.length * 23 + 20; // sized for the larger phone labels
  if (x - width < 0) return false;
  if (x + width > mapWidth) return true;
  return x < mapWidth * 0.64;
};
---

<div class="board-map">
  <div class="frame">
    <svg
      viewBox={`0 0 ${mapWidth} ${mapHeight}`}
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label={`Map of British Columbia marking where board members live: ${places.map((p) => p.name).join(', ')}`}
    >
      <g class="camera" data-camera>
        <path class="neighbours" d={map.neighbours} />
        <path class="province" d={map.bc} />
        {districts.map((d) => (
          <path class="district" d={d.d} data-member={d.member} />
        ))}
      </g>
      {places.map((p) => (
        <g
          class="marker"
          data-members={p.members.join(' ')}
          data-x={p.point[0]}
          data-y={p.point[1]}
          transform={`translate(${p.point[0]} ${p.point[1]})`}
        >
          <circle r="6" />
          <text
            x={labelLeft(p) ? -14 : 14}
            dy="0.35em"
            text-anchor={labelLeft(p) ? 'end' : 'start'}
          >
            {p.name}
          </text>
        </g>
      ))}
    </svg>
    <button type="button" class="reset" data-map-reset hidden>
      Show all of BC
    </button>
  </div>
</div>

<style>
  .board-map {
    height: 100%;
  }

  .frame {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .camera {
    transform-origin: 0 0;
  }

  .camera,
  .marker {
    transition: transform var(--duration-slower) var(--ease-standard);
  }

  .neighbours {
    fill: none;
    stroke: var(--color-border);
    stroke-opacity: 0.25;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .province {
    fill: var(--color-bg);
    stroke: var(--color-border);
    stroke-width: 1;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* Hidden until its member is selected. Animates opacity only (SPEC 8.2). */
  .district {
    fill: var(--color-accent);
    fill-opacity: 0.12;
    stroke: var(--color-accent);
    stroke-opacity: 0.5;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    opacity: 0;
    transition: opacity var(--duration-slower) var(--ease-standard);
  }

  .district.is-active {
    opacity: 1;
  }

  .marker circle {
    fill: var(--color-text-muted);
    stroke: var(--color-bg);
    stroke-width: 3;
  }

  .marker text {
    fill: var(--color-text);
    font-size: 24px;
    paint-order: stroke;
    stroke: var(--color-bg);
    stroke-width: 6;
    stroke-linejoin: round;
  }

  /* The map is drawn smaller on phones: keep labels readable. */
  @media (max-width: 64rem) {
    .marker circle {
      r: 10px;
    }

    .marker text {
      font-size: 40px;
    }
  }

  .marker.is-active circle {
    fill: var(--color-accent);
  }

  .marker.is-active text {
    font-weight: var(--font-weight-bold);
  }

  .reset {
    position: absolute;
    inset-block-start: var(--space-3);
    inset-inline-end: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-link);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .reset[hidden] {
    display: none;
  }
</style>
