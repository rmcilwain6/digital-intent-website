---
// One full-width band on Home (SPEC 7.1). Bands alternate between two
// background tones so each section reads as its own step. Heading, body and
// call to action come from content/home.ts; the slot holds anything extra
// (pillars, the map, a list), placed between the body and the call to action.
// Anything in the `aside` slot (the BC map) sits beside the text on wide
// screens and below it on phones.
import type { CallToAction as Cta } from '../../schemas/home';
import CallToAction from '../CallToAction.astro';
import DraftMarker from './DraftMarker.astro';

interface Props {
  id: string;
  heading: string;
  lead?: string | undefined;
  body: readonly string[];
  cta?: Cta | undefined;
  draft: boolean;
  tone: 'base' | 'surface';
}

const { id, heading, lead, body, cta, draft, tone } = Astro.props;
const headingId = `${id}-heading`;
// Render the aside rather than trusting Astro.slots.has: Home passes the map
// as `{key === 'map' && <BcMap slot="aside" />}`, and Astro registers that
// slot on every section in the loop, even where it renders nothing.
const aside = await Astro.slots.render('aside');
const hasAside = aside.trim() !== '';
---

<section class:list={['band', tone]} aria-labelledby={headingId}>
  <div class="container">
    {draft && <DraftMarker />}
    <div class:list={[{ split: hasAside }]}>
      <div class="main">
        <div class="prose">
          <h2 id={headingId}>{heading}</h2>
          {lead && <p class="lead">{lead}</p>}
          {body.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
        <slot />
      </div>
      {hasAside && (
        <div class="aside">
          <Fragment set:html={aside} />
        </div>
      )}
    </div>
    {cta && (
      <p class="cta-row">
        <CallToAction cta={cta} variant="secondary" />
      </p>
    )}
  </div>
</section>

<style>
  .band {
    padding-block: var(--space-8);
    background: var(--band-bg);
  }

  .base {
    --band-bg: var(--color-bg);
  }

  .surface {
    --band-bg: var(--color-surface);
  }

  h2 {
    margin-block-start: 0;
  }

  .lead {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-tight);
  }

  .split {
    container-type: inline-size;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-7) var(--space-8);
    align-items: center;
  }

  .split .main {
    flex: 1 1 20rem;
    max-width: 32rem;
    min-width: 0;
  }

  .split .aside {
    flex: 999 1 35rem;
    min-width: 0;
  }

  /*
   * Once the aside wraps below the text (main 20rem + gap 4rem + aside
   * 35rem), keep it to a modest width instead of letting it fill the band.
   */
  @container (max-width: 58.99rem) {
    .split .aside {
      max-inline-size: 36rem;
    }
  }

  .cta-row {
    margin-block: var(--space-6) 0;
  }
</style>
