---
// The break straight after the hero: one question split across the two
// worlds. The first half sits on paper, the second on navy, ending in the
// lime cursor. A pause, not an argument: nothing here answers it.
//
// The cursor blinks a few times and then holds still, so nothing blinks for
// more than a moment (WCAG 2.2.2). Under reduced motion the motion tokens
// make it still from the start.
import type { Home } from '../../schemas/home';

interface Props {
  question: Home['question'];
}

const { question } = Astro.props;
---

<p class="question">
  <span class="half analog">{question.analog}</span>{' '}
  <span class="half digital" data-theme="digital">
    {question.digital}
  </span>
</p>

<style>
  /* A step down from the hero's display size, centred: a pause between the
     hero and the sections. */
  .question {
    margin: 0;
    font-size: calc(0.75 * var(--text-display));
    text-align: center;
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-display);
    line-height: 1.04;
  }

  /* Each half is a full-width band; its text lines up with the page. */
  .half {
    display: block;
    padding-inline: max(
      var(--space-gutter),
      calc((100% - var(--width-page)) / 2)
    );
  }

  .analog {
    padding-block: calc(2 * var(--space-8)) var(--space-8);
  }

  /* Phones: less space between the hero and the question. */
  @media (width < 48rem) {
    .analog {
      padding-block: var(--space-7) var(--space-7);
    }

    .digital {
      padding-block: var(--space-7);
    }
  }

  .analog,
  .digital {
    text-wrap: balance;
  }

  .digital {
    padding-block: var(--space-7) var(--space-8);
  }

  /* The cursor, drawn after the last word with no space before it. */
  .digital::after {
    content: '';
    display: inline-block;
    inline-size: var(--cursor-width);
    block-size: var(--cursor-height);
    margin-inline-start: var(--cursor-gap);
    border-radius: var(--radius-sm);
    background: var(--color-signal);
    vertical-align: var(--cursor-drop);
    animation: blink var(--duration-blink) steps(1) 3;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
