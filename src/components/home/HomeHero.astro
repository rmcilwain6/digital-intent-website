---
// Home hero, Analog world (SPEC 7.1, D4; website frame design v1). On wide
// screens the header and hero fill exactly one screen: headline, lede and the
// two route cards on the left, and on the right a terraced stack of bridge
// photos sitting on the bottom edge, each wider than the one above, the widest
// bleeding off the right edge. Phones get the text and both cards first, then
// one full-width photo. No emphasis marks in the hero (design system).
import type { Home } from '../../schemas/home';
import IndexCard from './IndexCard.astro';
import ValleyviewWindow from './ValleyviewWindow.astro';

interface Props {
  hero: Home['hero'];
}

const { hero } = Astro.props;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container text">
    <h1 id="hero-heading">{hero.heading}</h1>
    <p class="lede">{hero.lede}</p>
    <div class="routes">
      <IndexCard card={hero.teachers} />
      <ValleyviewWindow card={hero.valleyview} />
    </div>
  </div>

  <ul class="photos">
    {hero.images.map((image) => (
      <li>
        <div class="slot">
          <span class="slot-label">[photo: {image.label}]</span>
          <span class="slot-note">{image.note}</span>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .hero {
    /* Height of the wide-screen site header, so header plus hero is 100vh. */
    --header-height: 8.75rem;
    /* Column spacing, and the height of everything in it but the headline
       (lede and both cards). Measured; update it if the cards change. */
    --pad: var(--space-6);
    --gap: var(--space-5);
    --column-rest: 27.75rem;
    /*
     * The stack is 3:1 slots at 100%, 80% and 62% width, so its height is
     * about 0.81 × its width. Cap the width so it never rises above the
     * hero, leaving a gap at the top.
     */
    --stack-max: calc((100svh - var(--header-height) - var(--space-8)) * 1.24);
    position: relative;
    overflow: clip;
  }

  .text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap);
    padding-block: var(--pad);
  }

  h1 {
    max-inline-size: 9.4em;
    margin: 0;
    font-size: var(--text-display);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
  }

  .lede {
    max-inline-size: 44ch;
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.55;
  }

  .routes {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    inline-size: min(100%, 27.5rem);
    margin-block-start: var(--space-1);
  }

  /* Photo stack */
  .photos {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    inline-size: 64%;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
  }

  .photos li {
    inline-size: 100%;
  }

  .photos li:nth-last-child(2) {
    inline-size: 80%;
  }

  .photos li:nth-last-child(3) {
    inline-size: 62%;
  }

  .slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    aspect-ratio: 3 / 1;
    padding: var(--space-3);
    border: 1.5px dashed var(--color-border);
    background: var(--color-surface);
    font-family: var(--font-mono);
    text-align: center;
  }

  /* The photos touch: no doubled border between them. */
  .photos li:not(:last-child) .slot {
    border-block-end: 0;
  }

  .slot-label {
    font-size: 0.8125rem;
  }

  .slot-note {
    max-inline-size: 34ch;
    color: var(--color-text-muted);
    font-size: 0.6875rem;
    line-height: 1.45;
  }

  /* Wide screens: header plus hero fill the screen, stack on the bottom right. */
  @media (width >= 64rem) {
    .hero {
      min-block-size: calc(100svh - var(--header-height));
    }

    /*
     * The headline (three lines) takes whatever height is left, so header
     * plus hero is exactly one screen. Never below 32px: on very short
     * screens the hero runs past the fold rather than cramping the text.
     */
    h1 {
      font-size: max(
        2rem,
        min(
          var(--text-display),
          (
              100svh - var(--header-height) - 2 * var(--pad) - 2 * var(--gap) -
                var(--column-rest)
            ) /
            3.06
        )
      );
    }

    .photos {
      position: absolute;
      inset-inline-end: 0;
      inset-block-end: 0;
      inline-size: min(50%, var(--stack-max));
    }
  }

  @media (width >= 80rem) {
    .photos {
      inline-size: min(58%, var(--stack-max));
    }
  }

  /* Shorter wide screens: tighter spacing, so the headline can stay larger. */
  @media (width >= 64rem) and (height < 56rem) {
    .hero {
      --pad: var(--space-5);
      --gap: var(--space-4);
    }
  }

  /* Phones: only the base photo, full width. */
  @media (width < 48rem) {
    .text {
      gap: var(--space-4);
    }

    .photos {
      inline-size: 100%;
    }

    .photos li:not(:last-child) {
      display: none;
    }

    .slot {
      aspect-ratio: 2 / 1;
      border-inline: 0;
    }
  }
</style>
