---
// Home hero, Analog world (SPEC 7.1, D4; website frame design v1). On wide
// screens the header and hero fill one screen: headline, lede and the two
// route cards on the left, and on the right a terraced stack of bridge photos
// sitting on the bottom edge, each wider than the one above, the widest
// bleeding off the right edge. Phones get the text and both cards first, then
// one full-width photo. No emphasis marks in the hero (design system).
import type { Home } from '../../schemas/home';
import DraftMarker from './DraftMarker.astro';
import IndexCard from './IndexCard.astro';
import ValleyviewWindow from './ValleyviewWindow.astro';

interface Props {
  hero: Home['hero'];
}

const { hero } = Astro.props;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container text">
    {hero.draft && <DraftMarker />}
    <h1 id="hero-heading">{hero.heading}</h1>
    <p class="lede">{hero.lede}</p>
    <div class="routes">
      <IndexCard card={hero.teachers} />
      <ValleyviewWindow card={hero.valleyview} />
    </div>
  </div>

  <ul class="photos">
    {hero.images.map((image) => (
      <li>
        <figure>
          <div class="slot">
            <span class="slot-label">[photo: {image.label}]</span>
            <span class="slot-note">{image.note}</span>
          </div>
          <figcaption>{image.caption}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
</section>

<style>
  .hero {
    /* Height of the desktop site header, so header and hero fill one screen. */
    --header-height: 8.75rem;
    position: relative;
    overflow: clip;
  }

  .text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    padding-block: var(--space-7) var(--space-6);
  }

  .text :global(.draft-marker) {
    margin-block-end: 0;
  }

  h1 {
    max-inline-size: 9.4em;
    margin: 0;
    font-size: var(--text-display);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
  }

  .lede {
    max-inline-size: 40ch;
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.55;
  }

  .routes {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    inline-size: min(100%, 27.5rem);
    margin-block-start: var(--space-1);
  }

  /* Photo stack */
  .photos {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    inline-size: 64%;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
  }

  .photos li {
    inline-size: 100%;
  }

  .photos li:nth-last-child(2) {
    inline-size: 80%;
  }

  .photos li:nth-last-child(3) {
    inline-size: 62%;
  }

  figure {
    position: relative;
    margin: 0;
  }

  .slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    aspect-ratio: 3 / 1;
    padding: var(--space-3);
    border: 1.5px dashed var(--color-border);
    background: var(--color-surface);
    font-family: var(--font-mono);
    text-align: center;
  }

  /* Room for the caption inside the slot, below the widest screens. */
  @media (width < 80rem) {
    .slot {
      padding-block-start: var(--space-6);
    }
  }

  /* The photos touch: no doubled border between them. */
  .photos li:not(:last-child) .slot {
    border-block-end: 0;
  }

  .slot-label {
    font-size: 0.8125rem;
  }

  .slot-note {
    max-inline-size: 34ch;
    color: var(--color-text-muted);
    font-size: 0.6875rem;
    line-height: 1.45;
  }

  /* Captions sit inside the slot, and beside it on the widest screens. */
  figcaption {
    position: absolute;
    inset-block-start: 0.625rem;
    inset-inline-start: var(--space-3);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  /* Wide screens: one screen tall, the stack on the bottom right. */
  @media (width >= 64rem) {
    .hero {
      min-block-size: max(40rem, calc(100svh - var(--header-height)));
    }

    .photos {
      position: absolute;
      inset-inline-end: 0;
      inset-block-end: 0;
      inline-size: 50%;
    }
  }

  @media (width >= 80rem) {
    .photos {
      inline-size: 58%;
    }

    figcaption {
      inset-inline: auto calc(100% + var(--space-3));
    }
  }

  /* Phones: only the base photo, full width, captioned on the photo. */
  @media (width < 48rem) {
    .text {
      gap: var(--space-4);
      padding-block: var(--space-6) var(--space-6);
    }

    .photos {
      inline-size: 100%;
    }

    .photos li:not(:last-child) {
      display: none;
    }

    .slot {
      aspect-ratio: 2 / 1;
      border-inline: 0;
    }

    figcaption {
      inset-block-start: auto;
      inset-block-end: 0.625rem;
      inset-inline: auto var(--space-3);
      padding: var(--space-1) var(--space-2);
      border-radius: var(--radius-sm);
      background: var(--color-navy);
      color: var(--color-paper);
      font-size: 0.6875rem;
    }
  }
</style>
