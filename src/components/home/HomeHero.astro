---
// Home hero, above the fold (SPEC 7.1, D4): who we are, the bridge idea, and
// two primary calls to action. Text beside a row of photo slots (one bridge
// per starting region) on wide screens; on narrow ones the text and calls to
// action come first so both stay near the top.
import type { Home } from '../../schemas/home';
import CallToAction from '../CallToAction.astro';
import ImagePlaceholder from '../ImagePlaceholder.astro';
import DraftMarker from './DraftMarker.astro';

interface Props {
  hero: Home['hero'];
}

const { hero } = Astro.props;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container layout">
    <div class="text">
      {hero.draft && <DraftMarker />}
      <h1 id="hero-heading">{hero.heading}</h1>
      <p class="lede">{hero.lede}</p>
      <ul class="ctas">
        {hero.ctas.map((cta) => (
          <li>
            <CallToAction cta={cta} />
          </li>
        ))}
      </ul>
    </div>
    <ul class="images" style={`--count: ${hero.images.length};`}>
      {hero.images.map((image) => (
        <li>
          <ImagePlaceholder {...image} />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-5) var(--space-7);
  }

  /* minmax(0, ...) stops the photo row from widening the column on phones. */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .hero {
      padding-block: var(--space-7) var(--space-8);
    }

    .layout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-7);
    }
  }

  h1 {
    margin-block-start: 0;
  }

  .lede {
    max-width: var(--width-prose);
    font-size: var(--text-lg);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .images {
    display: grid;
    grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
