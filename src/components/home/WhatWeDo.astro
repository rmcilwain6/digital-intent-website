---
// "What we do" on Home (SPEC 7.1 item 3): answers Why we exist. The mission
// first, then the four pillars as "what we focus on", each with one thing live
// now and one in the works, and a link to About.
//
// Wider screens: each pillar is a ruled index card beside its two items. Once
// the script runs (and the screen is tall enough), the cards gather into one
// stack that stays in view while the items scroll past. The top card changes
// to match, and cards you have passed lift off, so the pile shrinks as you go.
// Without JavaScript, or on a short screen, it stays a plain list.
//
// Phones: the four cards stacked, each one opening in place to show its items
// (an exclusive <details> group, so it works without JavaScript).
//
// Only one of the two layouts is displayed at a time, so the accessibility
// tree has each pillar once. The stack is decoration: hidden from assistive
// tech, which reads the list.
import { organization } from '../../../content/organization';
import type { WhatWeDo as Section } from '../../schemas/home';
import CallToAction from '../CallToAction.astro';
import RichText, { type Segment } from '../RichText.astro';
import DraftMarker from './DraftMarker.astro';
import FocusTrack from './FocusTrack.astro';

interface Props {
  id: string;
  section: Section;
  tone: 'base' | 'surface';
}

const { id, section, tone } = Astro.props;
const headingId = `${id}-heading`;
const wideId = `${id}-focus`;
const total = String(organization.pillars.length).padStart(2, '0');
// Each card marks one word of its pillar with the highlighter. The word must
// be in the pillar's board-voted wording, or the build stops.
const marked = (pillar: string, word: string): Segment[] => {
  const at = pillar.indexOf(word);
  if (at === -1) {
    throw new Error(`What we do: "${word}" is not in the pillar "${pillar}"`);
  }
  return [
    { text: pillar.slice(0, at) },
    { text: word, mark: true },
    { text: pillar.slice(at + word.length) },
  ].filter((segment) => segment.text);
};
const items = organization.pillars.map((pillar, index) => {
  const focus = section.focus[index]!;
  return {
    pillar,
    segments: marked(pillar, focus.highlight),
    number: String(index + 1).padStart(2, '0'),
    focus,
  };
});
const draft =
  section.draft ||
  section.focus.some((f) =>
    [f.now.title, f.now.text, f.next.title, f.next.text].some((t) =>
      t?.includes('[TK:'),
    ),
  );
---

<section class:list={['band', tone]} aria-labelledby={headingId}>
  <div class="container">
    {draft && <DraftMarker />}
    <div class="intro">
      <h2 id={headingId}>{section.heading}</h2>
      <p class="mission">{organization.mission}</p>
    </div>

    <div class="wide" data-focus>
      <div class="focus">
        <div class="rail">
          <h3 id={wideId} class="focus-heading">
            {section.focusHeading}
          </h3>
          <div class="deck">
            <div
              class="controls"
              role="group"
              aria-label={section.controls.label}
              data-controls
              hidden
            >
              <button
                type="button"
                class="step"
                aria-label={section.controls.previous}
                data-step="-1"
              >
                <svg
                  aria-hidden="true"
                  viewBox="0 0 16 16"
                  width="18"
                  height="18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M4 10l4-4 4 4"></path>
                </svg>
              </button>
              {items.map((item, index) => (
                <button
                  type="button"
                  class="dot"
                  aria-label={`${item.number}: ${item.pillar}`}
                  data-dot={String(index)}
                >
                  <span></span>
                </button>
              ))}
              <button
                type="button"
                class="step"
                aria-label={section.controls.next}
                data-step="1"
              >
                <svg
                  aria-hidden="true"
                  viewBox="0 0 16 16"
                  width="18"
                  height="18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M4 6l4 4 4-4"></path>
                </svg>
              </button>
            </div>
            <div class="stack" aria-hidden="true" data-stack hidden>
              {items.map((item, index) => (
                <div class="card stack-card" data-card data-pos={String(index)}>
                  <span class="number">
                    {item.number} / {total}
                  </span>
                  <p class="pillar">
                    <RichText segments={item.segments} />
                  </p>
                </div>
              ))}
            </div>
          </div>
          <p class="more">
            <CallToAction cta={section.cta} variant="secondary" />
          </p>
        </div>

        <ol class="list" aria-labelledby={wideId}>
          {items.map((item) => (
            <li class="item" data-item>
              <div class="card">
                <span class="number" aria-hidden="true">
                  {item.number} / {total}
                </span>
                <h4 class="pillar">
                  <RichText segments={item.segments} />
                </h4>
              </div>
              <FocusTrack focus={item.focus} labels={section.labels} />
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="narrow">
      <h3 class="focus-heading">{section.focusHeading}</h3>
      <div class="folds">
        {items.map((item) => (
          <details class="fold" name={`${id}-focus`}>
            <summary>
              <span class="fold-number" aria-hidden="true">
                {item.number}
              </span>
              <span class="fold-pillar">
                <RichText segments={item.segments} />
              </span>
              <svg
                class="chevron"
                aria-hidden="true"
                viewBox="0 0 16 16"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 6l4 4 4-4"></path>
              </svg>
            </summary>
            <div class="fold-body">
              <FocusTrack focus={item.focus} labels={section.labels} />
            </div>
          </details>
        ))}
      </div>
      <p class="more">
        <CallToAction cta={section.cta} variant="secondary" />
      </p>
    </div>
  </div>
</section>

<script>
  // Gather the cards into one stack that follows the scroll, only where it
  // reads well: wide enough for two columns and tall enough for the stack to
  // sit below the sticky header. Otherwise the plain list stays.
  const fits = window.matchMedia('(min-width: 48rem) and (min-height: 44rem)');

  document.querySelectorAll<HTMLElement>('[data-focus]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLElement>('[data-item]')];
    const stack = root.querySelector<HTMLElement>('[data-stack]');
    const cards = stack
      ? [...stack.querySelectorAll<HTMLElement>('[data-card]')]
      : [];
    const controls = root.querySelector<HTMLElement>('[data-controls]');
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const steps = [...root.querySelectorAll<HTMLButtonElement>('[data-step]')];
    if (!stack || !controls || items.length === 0) return;

    let current = 0;
    const show = (index: number) => {
      current = index;
      cards.forEach((card, i) => {
        card.dataset.pos = i < index ? 'read' : String(i - index);
      });
      dots.forEach((dot, i) => {
        if (i === index) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      steps.forEach((step) => {
        const to = index + Number(step.dataset.step);
        step.disabled = to < 0 || to >= items.length;
      });
    };

    // The dots and arrows scroll to that pillar's items, so the stack and the
    // list stay in step. The scroll stays within the stretch where the rail is
    // pinned, so the card never moves on screen. The stack goes straight to
    // the chosen card rather than flicking through the ones in between.
    const rail = root.querySelector<HTMLElement>('.rail');
    const focus = root.querySelector<HTMLElement>('.focus');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    let steering = false;
    let release = 0;
    const settle = () => {
      steering = false;
      window.clearTimeout(release);
    };
    const go = (index: number) => {
      const target = items[index];
      if (!target || !rail || !focus) return;
      const y = window.scrollY;
      const pinnedAt = parseFloat(getComputedStyle(rail).top) || 0;
      const area = focus.getBoundingClientRect();
      const pinStart = area.top + y - pinnedAt;
      const pinEnd = Math.max(
        pinStart,
        area.bottom + y - pinnedAt - rail.offsetHeight,
      );
      const box = target.getBoundingClientRect();
      const centred = box.top + y + box.height / 2 - window.innerHeight / 2;
      const top = Math.min(Math.max(centred, pinStart), pinEnd);

      show(index);
      steering = true;
      window.clearTimeout(release);
      release = window.setTimeout(settle, 1000);
      window.addEventListener('scrollend', settle, { once: true });
      window.scrollTo({ top, behavior: still.matches ? 'auto' : 'smooth' });
    };
    dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));
    steps.forEach((step) =>
      step.addEventListener('click', () =>
        go(current + Number(step.dataset.step)),
      ),
    );

    // An item is current while it crosses the middle of the screen. While a
    // dot or arrow is scrolling, the choice already made stands.
    const observer = new IntersectionObserver(
      (entries) => {
        if (steering) return;
        for (const entry of entries) {
          if (entry.isIntersecting)
            show(items.indexOf(entry.target as HTMLElement));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );

    const apply = () => {
      if (fits.matches) {
        root.classList.add('is-stacked');
        stack.hidden = false;
        controls.hidden = false;
        show(current);
        items.forEach((item) => observer.observe(item));
      } else {
        root.classList.remove('is-stacked');
        stack.hidden = true;
        controls.hidden = true;
        observer.disconnect();
      }
    };
    apply();
    fits.addEventListener('change', apply);
  });
</script>

<style>
  .band {
    padding-block: var(--space-8) calc(2 * var(--space-8));
    background: var(--band-bg);
  }

  .base {
    --band-bg: var(--color-bg);
  }

  .surface {
    --band-bg: var(--color-surface);
  }

  .intro {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-8);
    }
  }

  h2 {
    margin-block: 0;
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-tight);
  }

  /* The mission is the section's lead: large, at a comfortable measure. */
  .mission {
    max-inline-size: 26em;
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-tight);
  }

  .focus-heading {
    margin-block: calc(1.5 * var(--space-8)) 0;
    font-size: var(--text-xl);
  }

  .wide {
    margin-block-start: calc(1.5 * var(--space-8));
  }

  .wide .focus-heading {
    margin: 0;
  }

  .more {
    margin-block: var(--space-6) 0;
  }

  /* The dashed dot is hollow: it takes the ground it sits on. */
  .wide {
    --dot-bg: var(--band-bg);
  }

  /* Only one layout at a time. */
  @media (width < 48rem) {
    .wide {
      display: none;
    }
  }

  @media (min-width: 48rem) {
    .narrow {
      display: none;
    }
  }

  /*
   * The index card: lighter paper, a pen-red header rule, and faint ruled
   * lines that each line of the pillar sits on. The top layer is plain card,
   * so no ruled line shows above the header rule.
   */
  .card {
    --row: 2.25rem;
    position: relative;
    padding: 0.875rem var(--space-5) var(--space-5);
    border: var(--border-width) solid var(--color-border);
    background-color: var(--color-card);
    background-image:
      linear-gradient(var(--color-card), var(--color-card)),
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent calc(var(--row) - 1px),
        var(--color-card-rule) calc(var(--row) - 1px),
        var(--color-card-rule) var(--row)
      );
    background-position:
      0 0,
      0 2.75rem;
    background-repeat: no-repeat, repeat;
    background-size:
      100% 2.75rem,
      auto;
  }

  .card::before {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 2.5rem;
    block-size: 2px;
    background: var(--color-marker);
    content: '';
  }

  .number {
    display: block;
    block-size: 1.625rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* One blank ruled line above the pillar, so it doesn't crowd the red rule. */
  .pillar {
    margin: calc(0.25rem + var(--row)) 0 0;
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--row);
  }

  /*
   * Plain list: the heading, each card beside its two items, then the link.
   * The rail's box steps aside so its heading and link can sit either side
   * of the list.
   */
  .focus {
    display: flex;
    flex-direction: column;
  }

  .rail {
    display: contents;
  }

  .list {
    display: grid;
    order: 1;
    gap: var(--space-8);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .wide .more {
    order: 2;
  }

  .item {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-7);
    align-items: start;
  }

  .stack[hidden] {
    display: none;
  }

  /*
   * Stacked: the stack stays in view on the left, clear of the header, and
   * the items scroll past on the right with room for each to be current.
   */
  .is-stacked .focus {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-8);
    align-items: start;
  }

  .is-stacked .list {
    grid-column: 2;
    grid-row: 1;
    gap: 0;
  }

  /* The heading, stack and link stay in view together, well clear of the
     header. */
  .is-stacked .rail {
    position: sticky;
    inset-block-start: calc(var(--header-clearance) + var(--space-7));
    display: block;
    grid-column: 1;
    grid-row: 1;
  }

  /* The controls sit to the left of the stack, level with the card. */
  .is-stacked .deck {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
    margin-block-start: var(--space-5);
  }

  /* The link lines up under the card, not the controls. */
  .is-stacked .more {
    margin-inline-start: calc(2.75rem + var(--space-4));
  }

  .controls[hidden] {
    display: none;
  }

  .controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block-start: var(--space-6);
  }

  .step,
  .dot {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    background: none;
    color: var(--color-text);
    cursor: pointer;
  }

  .step:hover:not(:disabled),
  .dot:hover {
    background: var(--color-surface);
  }

  .step:disabled {
    color: var(--color-border);
    cursor: default;
  }

  .dot span {
    box-sizing: border-box;
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border: 2px solid var(--color-text);
    border-radius: 50%;
  }

  .dot[aria-current='true'] span {
    background: var(--color-text);
  }

  .is-stacked .item {
    display: block;
    min-block-size: 45svh;
    padding-block: var(--space-6);
  }

  /* The list's own cards give way to the stack, but stay for screen readers. */
  .is-stacked .item > .card {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The stack: the cards share one cell, those behind slightly smaller and
     lower, so their edges show. Room below for the edges. */
  .stack {
    display: grid;
    padding-block-end: 2.625rem;
  }

  .stack-card {
    grid-area: 1 / 1;
    transform-origin: 50% 100%;
    transition:
      transform var(--duration-slow) var(--ease-standard),
      opacity var(--duration-slow) var(--ease-standard);
  }

  .stack-card {
    min-block-size: 20rem;
  }

  .stack-card .pillar {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
  }

  .stack-card .number,
  .stack-card .pillar {
    transition: opacity var(--duration-base) var(--ease-standard);
  }

  .stack-card:not([data-pos='0']) .number,
  .stack-card:not([data-pos='0']) .pillar {
    opacity: 0;
  }

  .stack-card[data-pos='0'] {
    z-index: 4;
  }

  .stack-card[data-pos='1'] {
    z-index: 3;
    transform: translateY(0.875rem) scale(0.96);
  }

  .stack-card[data-pos='2'] {
    z-index: 2;
    transform: translateY(1.75rem) scale(0.92);
  }

  .stack-card[data-pos='3'] {
    z-index: 1;
    transform: translateY(2.625rem) scale(0.88);
  }

  /* Passed: lifted off the top of the pile. */
  .stack-card[data-pos='read'] {
    z-index: 5;
    opacity: 0;
    transform: translateY(calc(-1 * var(--motion-distance-md)));
  }

  /* Phones: four cards, one opening at a time. */
  .folds {
    display: grid;
    margin-block-start: var(--space-5);
  }

  .fold {
    --row: 1.75rem;
    --dot-bg: var(--color-card);
    border: var(--border-width) solid var(--color-border);
    background: var(--color-card);
  }

  .fold + .fold {
    margin-block-start: -1px;
  }

  .fold[open] {
    position: relative;
    z-index: 1;
    margin-block: var(--space-2);
    border-color: var(--color-text);
  }

  summary {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) 1.25rem;
    gap: var(--space-2);
    align-items: start;
    min-block-size: 2.75rem;
    padding: 0.875rem var(--space-4);
    background-image:
      linear-gradient(var(--color-card), var(--color-card)),
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent calc(var(--row) - 1px),
        var(--color-card-rule) calc(var(--row) - 1px),
        var(--color-card-rule) var(--row)
      );
    background-position:
      0 0,
      0 0.875rem;
    background-repeat: no-repeat, repeat;
    background-size:
      100% 0.875rem,
      auto;
    line-height: var(--row);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .fold[open] summary {
    border-block-end: 2px solid var(--color-marker);
  }

  .fold-number {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .fold-pillar {
    font-weight: var(--font-weight-bold);
  }

  .chevron {
    margin-block-start: 0.3rem;
    transition: transform var(--duration-base) var(--ease-standard);
  }

  .fold[open] .chevron {
    transform: rotate(180deg);
  }

  .fold-body {
    padding: var(--space-5) var(--space-4);
  }
</style>
