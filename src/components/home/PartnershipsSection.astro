---
// The Partnerships band on Home (SPEC 7.1 item 8, D27). The drawing sits on
// the left on wide screens with the invitation on the right; on phones the
// text comes first and the web follows. The web is drawn to read as a quick
// pen sketch: groups in loose ovals, Digital Intent one more node circled in
// marker, lines to each other and off the edge to show the network goes on.
// It is a stand-in until Carter draws one by hand. Copy is in content/home.ts.
import { brand } from '../../brand/brand.config';
import { isPlaceholder } from '../../lib/placeholder';
import type { Partnerships } from '../../schemas/home';
import DraftMarker from './DraftMarker.astro';
import RichText, { type Segment } from '../RichText.astro';

interface Props {
  id: string;
  section: Partnerships;
  tone: 'base' | 'surface';
}

const { id, section, tone } = Astro.props;
const headingId = `${id}-heading`;

const at = section.heading.indexOf(section.highlight);
if (at === -1) {
  throw new Error(
    `Partnerships: "${section.highlight}" is not in the heading "${section.heading}"`,
  );
}
const headingSegments: Segment[] = [
  { text: section.heading.slice(0, at) },
  { text: section.highlight, mark: true },
  { text: section.heading.slice(at + section.highlight.length) },
].filter((s) => s.text);

const mailto = isPlaceholder(brand.email)
  ? undefined
  : `mailto:${brand.email}?subject=${encodeURIComponent(section.email.subject)}`;

// Drawing geometry. Nodes 0 to 5 are the groups in content order; 6 is us.
type Node = { cx: number; cy: number; rx: number; ry: number };
type Variant = {
  name: 'wide' | 'narrow';
  width: number;
  height: number;
  size: number;
  nodes: Node[];
  links?: [number, number][];
  strays: [number, number, number][];
};

const variants: Variant[] = [
  {
    name: 'wide',
    width: 560,
    height: 480,
    size: 17,
    nodes: [
      { cx: 130, cy: 70, rx: 110, ry: 30 },
      { cx: 420, cy: 60, rx: 85, ry: 28 },
      { cx: 470, cy: 235, rx: 82, ry: 40 },
      { cx: 95, cy: 260, rx: 88, ry: 40 },
      { cx: 190, cy: 405, rx: 100, ry: 40 },
      { cx: 430, cy: 400, rx: 92, ry: 40 },
      { cx: 285, cy: 215, rx: 95, ry: 36 },
    ],
    strays: [
      [0, 270, 15],
      [3, 18, 150],
      [3, 20, 445],
      [1, 548, 140],
      [5, 540, 470],
      [4, 312, 470],
    ],
  },
  {
    name: 'narrow',
    width: 360,
    height: 640,
    size: 16,
    nodes: [
      { cx: 120, cy: 50, rx: 100, ry: 30 },
      { cx: 262, cy: 150, rx: 80, ry: 28 },
      { cx: 272, cy: 330, rx: 78, ry: 40 },
      { cx: 95, cy: 420, rx: 82, ry: 40 },
      { cx: 250, cy: 505, rx: 92, ry: 40 },
      { cx: 110, cy: 590, rx: 82, ry: 40 },
      { cx: 125, cy: 255, rx: 92, ry: 36 },
    ],
    // Stacked tall, so each node links to its neighbours down the page.
    links: [
      [6, 0],
      [6, 1],
      [6, 2],
      [6, 3],
      [0, 1],
      [1, 2],
      [2, 4],
      [3, 4],
      [3, 5],
      [4, 5],
    ],
    strays: [
      [1, 345, 45],
      [2, 352, 240],
      [3, 15, 330],
      [4, 352, 610],
    ],
  },
];

// Who links to whom on the wide drawing: us to every group, and the groups
// to each other.
const wideLinks: [number, number][] = [
  [6, 0],
  [6, 1],
  [6, 2],
  [6, 3],
  [6, 4],
  [6, 5],
  [0, 3],
  [0, 1],
  [3, 4],
  [4, 5],
  [2, 5],
  [1, 2],
];

const r = (n: number) => Math.round(n * 10) / 10;

/** A gently bowed line from a to b, like one drawn by hand. */
const curve = (
  a: { cx: number; cy: number },
  bx: number,
  by: number,
  i: number,
) => {
  const mx = (a.cx + bx) / 2;
  const my = (a.cy + by) / 2;
  const dx = bx - a.cx;
  const dy = by - a.cy;
  const bend = (i % 2 === 0 ? 0.14 : -0.11) * (1 + (i % 3) * 0.15);
  return `M ${a.cx} ${a.cy} Q ${r(mx - dy * bend)} ${r(my + dx * bend)} ${bx} ${by}`;
};

/** A loose oval that overshoots where the pen comes back round. */
const oval = ({ cx, cy, rx, ry }: Node, tail = false) => {
  const d = `M ${cx - rx} ${cy + 2} C ${cx - rx} ${r(cy - 1.3 * ry)} ${r(cx + 1.05 * rx)} ${r(cy - 1.25 * ry)} ${cx + rx} ${cy - 2} C ${r(cx + 0.98 * rx)} ${r(cy + 1.3 * ry)} ${r(cx - 0.9 * rx)} ${r(cy + 1.28 * ry)} ${cx - rx - 3} ${cy - 6}`;
  return tail
    ? `${d} C ${cx - rx - 5} ${cy - 14} ${cx - rx + 9} ${cy - 22} ${cx - rx + 25} ${cy - 25}`
    : d;
};

const drawings = variants.map((v) => {
  const lines = (v.links ?? wideLinks).map(([a, b], i) =>
    curve(v.nodes[a]!, v.nodes[b]!.cx, v.nodes[b]!.cy, i),
  );
  const strays = v.strays.map(([from, x, y], i) => ({
    d: curve(v.nodes[from]!, x, y, i + 1),
    x,
    y,
  }));
  const nodes = section.network.groups.map((lineTexts, i) => {
    const node = v.nodes[i]!;
    const lead = v.size + 5;
    const first = lineTexts.length === 1 ? node.cy + 6 : node.cy - 5;
    return {
      d: oval(node),
      cx: node.cx,
      lines: lineTexts.map((text, j) => ({ text, y: first + j * lead })),
    };
  });
  const self = v.nodes[6]!;
  return {
    ...v,
    lines,
    strays,
    nodes,
    self: { d: oval(self, true), cx: self.cx, y: self.cy + 7 },
    titleId: `${id}-${v.name}-title`,
    descId: `${id}-${v.name}-desc`,
  };
});

const description = `${brand.shortName} is one node among: ${section.network.groups
  .map((g) => g.join(' '))
  .join(
    ', ',
  )}. The groups are linked to each other as well, and lines run off the edge to more of the network.`;

const { partners } = section;
---

<section class:list={['band', tone]} aria-labelledby={headingId}>
  <div class="container">
    {section.draft && <DraftMarker />}
    <div class="split">
      <div class="text">
        <h2 id={headingId}>
          <RichText segments={headingSegments} />
        </h2>
        {section.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <p class="actions">
          {mailto ? (
            <a class="email-button" href={mailto}>
              {section.email.label}
            </a>
          ) : (
            <span class="email-button pending">{section.email.label}</span>
          )}
          <span class="address">
            {mailto ? <a href={mailto}>{brand.email}</a> : brand.email}
          </span>
        </p>
      </div>

      <figure class="web">
        {drawings.map((v) => (
          <svg
            class:list={['drawing', v.name]}
            viewBox={`0 0 ${v.width} ${v.height}`}
            role="img"
            aria-labelledby={`${v.titleId} ${v.descId}`}
          >
            <title id={v.titleId}>{section.network.label}</title>
            <desc id={v.descId}>{description}</desc>
            <g class="lines">
              {v.lines.map((d) => (
                <path d={d} />
              ))}
            </g>
            <g class="lines echo">
              {v.lines.map((d) => (
                <path d={d} />
              ))}
            </g>
            <g class="strays">
              {v.strays.map((s) => (
                <path d={s.d} />
              ))}
            </g>
            <g class="dots">
              {v.strays.map((s) => (
                <circle cx={s.x} cy={s.y} r="4" />
              ))}
            </g>
            <g class="nodes" font-size={v.size}>
              {v.nodes.map((n) => (
                <g>
                  <path class="oval" d={n.d} />
                  <text x={n.cx}>
                    {n.lines.map((l) => (
                      <tspan x={n.cx} y={l.y}>
                        {l.text}
                      </tspan>
                    ))}
                  </text>
                </g>
              ))}
              <path class="oval self" d={v.self.d} />
              <text class="self-name" x={v.self.cx} y={v.self.y}>
                {brand.shortName}
              </text>
            </g>
          </svg>
        ))}
      </figure>
    </div>

    {partners.items.length > 0 && (
      <div class="partners">
        <h3>{partners.heading}</h3>
        <ul>
          {partners.items.map((p) => {
            const mark = p.logo ? <img src={p.logo} alt={p.name} /> : p.name;
            return <li>{p.href ? <a href={p.href}>{mark}</a> : mark}</li>;
          })}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  .band {
    padding-block: var(--space-8);
    background: var(--band-bg);
  }

  .base {
    --band-bg: var(--color-bg);
  }

  .surface {
    --band-bg: var(--color-surface);
  }

  /* Text first in the source and on phones; the drawing moves left when
     there is room for both. */
  .split {
    display: flex;
    flex-wrap: wrap;
    flex-direction: row-reverse;
    gap: var(--space-7) var(--space-8);
    align-items: center;
    justify-content: flex-end;
  }

  .text {
    flex: 1 1 22rem;
    max-inline-size: 34rem;
    min-inline-size: 0;
  }

  h2 {
    margin-block-start: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    margin-block: var(--space-6) 0;
  }

  .email-button {
    display: inline-block;
    padding: var(--space-3) var(--space-5);
    border: var(--border-width) solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-tight);
    text-decoration: none;
  }

  a.email-button:hover {
    text-decoration: underline;
  }

  .email-button.pending {
    border-style: dashed;
    border-color: var(--color-border);
    background: transparent;
    color: var(--color-text);
  }

  .web {
    container-type: inline-size;
    flex: 1 1 26rem;
    max-inline-size: 35rem;
    min-inline-size: 0;
    margin: 0;
  }

  .drawing {
    display: block;
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .narrow {
    display: none;
    max-inline-size: 26rem;
    margin-inline: auto;
  }

  /* Too narrow for the wide drawing's labels to stay readable. */
  @container (max-width: 29.99rem) {
    .wide {
      display: none;
    }

    .narrow {
      display: block;
    }
  }

  .lines {
    stroke: var(--color-text);
    stroke-width: 1.6;
    opacity: 0.55;
  }

  /* A second, fainter pass, slightly off, so lines read as pen not vector. */
  .echo {
    opacity: 0.2;
    transform: translate(1.6px, 1.2px);
  }

  .strays {
    stroke: var(--color-border);
    stroke-width: 1.4;
    stroke-dasharray: 2 5;
  }

  .dots {
    fill: var(--color-border);
  }

  .oval {
    fill: var(--band-bg);
    stroke: var(--color-text);
    stroke-width: 1.7;
  }

  .oval.self {
    stroke: var(--color-marker);
    stroke-width: 3.2;
  }

  text {
    fill: var(--color-text);
    font-family: var(--font-sans);
    font-weight: var(--font-weight-bold);
    text-anchor: middle;
  }

  .self-name {
    font-size: 1.25em;
  }

  .partners {
    margin-block-start: var(--space-7);
    padding-block-start: var(--space-5);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .partners h3 {
    margin-block: 0 var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-regular);
  }

  .partners ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-6);
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .partners img {
    display: block;
    max-block-size: 3rem;
    inline-size: auto;
  }
</style>
