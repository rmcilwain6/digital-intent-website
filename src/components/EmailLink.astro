---
// An email address from brand config, the organization's by default. Shows a
// placeholder as plain text until the address exists (D21), so there is no
// broken mailto: link.
import { brand } from '../brand/brand.config';
import { isPlaceholder } from '../lib/placeholder';

interface Props {
  /** Which brand address to show. */
  address?: 'email' | 'privacyEmail';
}

const email = brand[Astro.props.address ?? 'email'];
---

{isPlaceholder(email) ? (
  <span>{email}</span>
) : (
  <a href={`mailto:${email}`}>{email}</a>
)}
