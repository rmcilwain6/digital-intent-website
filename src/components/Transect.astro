---
// Elevation profile from Victoria to Kicking Horse Pass under the header
// (design system: Transect). Decorative, so hidden from assistive tech. The
// lime cursor shows how far down the page the reader is: it starts at
// Victoria and reaches the Rockies at the footer. Without JavaScript it stays
// at Victoria. Position, not animation, so it tracks scroll under reduced
// motion too, with no easing.
import {
  areaPath,
  labels,
  ridgePath,
  VIEW_HEIGHT,
  VIEW_WIDTH,
} from '../lib/transect';
---

<div class="transect" aria-hidden="true" data-transect>
  <svg
    viewBox={`0 0 ${VIEW_WIDTH} ${VIEW_HEIGHT}`}
    preserveAspectRatio="none"
    focusable="false"
  >
    <path class="area" d={areaPath}></path>
    <path class="ridge" d={ridgePath}></path>
  </svg>
  <div class="track">
    <span class="cursor"></span>
  </div>
  <ul class="labels">
    {labels.map((label, i) => (
      <li
        class:list={{ first: i === 0, minor: label.minor }}
        style={`left: ${label.percent}%`}
      >
        {label.name}
      </li>
    ))}
  </ul>
</div>

<script>
  const transect = document.querySelector<HTMLElement>('[data-transect]');
  if (transect) {
    let queued = false;
    const update = () => {
      queued = false;
      const root = document.documentElement;
      const scrollable = root.scrollHeight - window.innerHeight;
      const progress =
        scrollable > 0
          ? Math.min(1, Math.max(0, window.scrollY / scrollable))
          : 0;
      transect.style.setProperty('--progress', progress.toFixed(4));
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    update();
  }
</script>

<style>
  .transect {
    --profile-height: 2.5rem;
    position: relative;
    padding-block-end: var(--space-5);
    /* The cursor's track slides right as the page scrolls; clip it so it never
       makes the page wider than the screen. */
    overflow: clip;
  }

  svg {
    display: block;
    inline-size: 100%;
    block-size: var(--profile-height);
  }

  .area {
    fill: var(--color-surface);
  }

  .ridge {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  /* The track is the width the cursor can travel; it moves by transform only. */
  .track {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: calc(100% - 2px);
    transform: translateX(calc(var(--progress, 0) * 100%));
  }

  .cursor {
    display: block;
    inline-size: 2px;
    block-size: calc(var(--profile-height) + 2px);
    border-radius: 1px;
    background: var(--color-signal);
  }

  .labels {
    position: absolute;
    inset-inline: 0;
    inset-block-start: calc(var(--profile-height) + var(--space-1));
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.3;
    color: var(--color-text-muted);
    text-transform: lowercase;
  }

  li {
    position: absolute;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  /* The first label keeps clear of the screen's left edge. */
  li.first {
    margin-inline-start: var(--space-gutter);
    transform: none;
  }

  /* Rogers Pass and Golden collide below the full page width. */
  @media (width < 80rem) {
    li.minor {
      display: none;
    }
  }

  /* Phones: a shorter profile and no labels. */
  @media (width < 48rem) {
    .transect {
      --profile-height: 1.375rem;
      padding-block-end: var(--space-1);
    }

    .labels {
      display: none;
    }
  }
</style>
