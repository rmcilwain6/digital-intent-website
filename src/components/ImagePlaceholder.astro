---
// Labelled image slot at its final aspect ratio, with an art-direction note.
// Stays until original photography exists (SPEC rule 8, 8.2).
interface Props {
  /** CSS aspect ratio, e.g. "4 / 5". */
  ratio: string;
  /** What the image is, e.g. "Portrait". */
  label: string;
  /** One-line art-direction note. */
  note: string;
  /**
   * For small slots: the label only, with the note shown on hover and kept
   * for assistive technology.
   */
  compact?: boolean;
}

const { ratio, label, note, compact = false } = Astro.props;
---

{compact ? (
  <div
    class="image-placeholder compact"
    style={`aspect-ratio: ${ratio};`}
    title={note}
  >
    <p>
      {label}
      <span class="note">: {note}</span>
    </p>
  </div>
) : (
  <div class="image-placeholder" style={`aspect-ratio: ${ratio};`}>
    <p>
      <strong>Image placeholder: {label}</strong>
    </p>
    <p>{note}</p>
  </div>
)}

<style>
  .image-placeholder {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-4);
    border: var(--border-width) dashed var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  p {
    margin: 0;
  }

  .compact {
    align-items: center;
    padding: var(--space-1);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    text-align: center;
  }

  /* Visually hidden, read by assistive technology. */
  .compact .note {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
