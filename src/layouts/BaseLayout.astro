---
// The frame every page sits in: document head, skip link, header, footer
// (SPEC section 7, shared elements). Brand values come from src/brand/.
import '../brand/brand.css';
import '../styles/global.css';
import { brand } from '../brand/brand.config';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  /** Page name for the <title>. Omit on Home, which uses the organization name alone. */
  title?: string;
  /** Meta description. */
  description: string;
  /** Keep the page out of search results, e.g. fixtures. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const documentTitle = title ? `${title} | ${brand.name}` : brand.name;
const lang = Astro.currentLocale ?? 'en';
---

<!doctype html>
<!-- Pages are Analog by default; sections opt into Digital (record 0005). -->
<html lang={lang} data-theme="analog">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={brand.favicon} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    <SiteHeader />
    <main id="main" class="container">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
