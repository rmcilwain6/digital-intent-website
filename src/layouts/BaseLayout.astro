---
// The frame every page sits in: document head, skip link, header, footer
// (SPEC section 7, shared elements). Brand values come from src/brand/.
import '../brand/brand.css';
import '../styles/global.css';
import { brand } from '../brand/brand.config';
import { preloadFonts } from '../brand/fonts';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  /** Page name for the <title>. Omit on Home, which uses the organization name alone. */
  title?: string;
  /** Meta description. */
  description: string;
  /** Keep the page out of search results, e.g. fixtures. */
  noindex?: boolean;
  /** Let sections span the full width and set their own containers, as on Home. */
  fullWidth?: boolean;
  /** Put the whole main area in one world, e.g. the Digital 404 page (record 0005). */
  theme?: 'analog' | 'digital';
}

const {
  title,
  description,
  noindex = false,
  fullWidth = false,
  theme,
} = Astro.props;
const documentTitle = title ? `${title} | ${brand.name}` : brand.name;
const lang = Astro.currentLocale ?? 'en';
// Absolute URLs from `site` (set from brand.domain in astro.config.mjs).
// Noindex pages (fixtures, 404) get no canonical: the 404 is served at
// whatever address was missing, so it has no URL of its own.
const canonical = noindex
  ? undefined
  : new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL(brand.socialImage.src, Astro.site).href;
---

<!doctype html>
<!-- Pages are Analog by default; sections opt into Digital (record 0005). -->
<html lang={lang} data-theme="analog">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {preloadFonts.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <link rel="icon" href={brand.favicon} type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={String(brand.socialImage.width)} />
    <meta
      property="og:image:height"
      content={String(brand.socialImage.height)}
    />
    <meta property="og:image:alt" content={brand.socialImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <!--
      Marks the page as able to run scripts, before first paint, so styles for
      script-enhanced views (such as the Team page on phones) apply with no
      flash. Without JavaScript the class is absent and pages show their
      complete, still version (rule 4).
    -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    <SiteHeader />
    <main id="main" class:list={[{ container: !fullWidth }]} data-theme={theme}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
