---
// The frame every page sits in: document head, skip link, header, footer
// (SPEC section 7, shared elements). Brand values come from src/brand/.
import '../brand/brand.css';
import '../styles/global.css';
import { brand } from '../brand/brand.config';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  /** Page name for the <title>. Omit on Home, which uses the organization name alone. */
  title?: string;
  /** Meta description. */
  description: string;
  /** Keep the page out of search results, e.g. fixtures. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const documentTitle = title ? `${title} | ${brand.name}` : brand.name;
const lang = Astro.currentLocale ?? 'en';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={brand.favicon} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <!--
      Runs before first paint so the stored theme applies with no flash (SPEC T7).
      Marks the page as JS-capable so the theme toggle can show. The storage key
      must match ThemeToggle.astro. Only the theme preference is stored (rule 2).
    -->
    <script is:inline>
      (function () {
        const root = document.documentElement;
        root.classList.add('js');
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            root.dataset.theme = stored;
          }
        } catch {
          // Storage blocked: follow the system setting.
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    <SiteHeader />
    <main id="main" class="container">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
